{
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/deal",
      "schedule": "5 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/team/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

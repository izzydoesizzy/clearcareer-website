---
import { offer, survey, SURVEY_SOURCE, NEW_PROGRAM_NOTE } from "@/data/llu";
import LluButton from "./LluButton.astro";
import ProofBar from "@components/proof/ProofBar.astro";
---

<section class="llu-band llu-band--navy llu-hero" id="top">
  <div class="llu-wrap">
    <div class="llu-hero__inner">
      <p class="llu-pill">For experienced professionals between roles</p>
      <h1 class="llu-display">You shouldn't have to job search alone.</h1>
      <p class="llu-lead llu-hero__sub">
        A small paid room for professionals between roles. We rebuild your resume and LinkedIn together, then work your
        search live every Wednesday.
      </p>
      <LluButton />
      <p class="llu-cap">
        {offer.dealLive && <>Black Friday pricing ends {offer.dealEndsLong}. </>}We start {offer.startDateShort}.
        <span class="llu-num">{offer.seatsTotal}</span> seats.
      </p>
      <ProofBar tone="dark" />
    </div>

    <div class="llu-hero__stats">
      <dl class="llu-ruled llu-ruled--3">
        <div>
          <dt class="llu-stat__fig llu-stat__fig--xl">${(survey.avgRaise / 1000).toFixed(1)}K</dt>
          <dd class="llu-stat__label">average raise for those who landed a role</dd>
        </div>
        <div>
          <dt class="llu-stat__fig llu-stat__fig--xl">{survey.confidentAfterPct}%</dt>
          <dd class="llu-stat__label">felt confident in their search after, up from {survey.confidentBeforePct}%</dd>
        </div>
        <div>
          <dt class="llu-stat__fig llu-stat__fig--xl">{survey.avgRating.toFixed(2)} / 5</dt>
          <dd class="llu-stat__label">average rating of my programs</dd>
        </div>
      </dl>
      <p class="llu-cap llu-mt-24">{SURVEY_SOURCE} {NEW_PROGRAM_NOTE} Results vary.</p>
    </div>
  </div>
</section>

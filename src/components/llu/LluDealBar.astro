---
import { offer } from "@/data/llu";
---

{offer.dealLive && (<div class="llu-dealbar">
  <div class="llu-wrap llu-dealbar__row">
    <p class="llu-dealbar__text">
      <span class="llu-dealbar__label">{offer.dealBarLabel}</span>
      <span class="llu-dealbar__long">{offer.dealBarLong}</span>
      <span class="llu-dealbar__short">{offer.dealBarShort}</span>
    </p>
    <a class="llu-dealbar__link" href="#pricing">See the prices</a>
  </div>
</div>)}

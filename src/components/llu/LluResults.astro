---
import { cases, reviews, RESULTS_VARY, NEW_PROGRAM_NOTE, VIDEO_URL } from "@/data/llu";
import LluImg from "./LluImg.astro";
import LluButton from "./LluButton.astro";
import LluReviewCard from "./LluReviewCard.astro";
import { faces, originals, videoThumb } from "./images";
import WinsGrid from "@components/proof/WinsGrid.astro";
import ReviewWall from "@components/proof/ReviewWall.astro";
import { winNames } from "@data/proof";

/** The YouTube ID, for the in-page player. */
const videoId = new URL(VIDEO_URL).searchParams.get("v") ?? VIDEO_URL.split("/").pop();

/**
 * One appearance per person on this page. Cases: Darin, Laura, Blake. "What's inside": Sparsh, Tamara.
 * Beside the video: Kristin. About Izzy: Heidi. Everyone else appears once, below.
 */
const featured = ["Darin M.", "Laura S.", "Blake M.", "Sparsh K.", "Tamara G.", "Kristin D.", "Heidi P."];
---

<section class="llu-band llu-band--navy" id="results">
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">Results</p>
      <h2 class="llu-h2">What people did next.</h2>
    </div>

    <div class="llu-grid llu-grid--3 llu-mt-72">
      {
        cases.map((c) => (
          <article class="llu-card llu-stack">
            <div class="llu-who">
              <LluImg class="llu-face" img={faces[c.key]} alt="" size={56} />
              <p>
                <span class="llu-who__name">{reviews[c.key].name}</span>
                <span class="llu-cap llu-block">{reviews[c.key].context}</span>
              </p>
            </div>
            <p><span class="llu-chip llu-chip--solid llu-num">{c.chip}</span></p>
            <div>
              <p class="llu-eyebrow">The starting point</p>
              <p class="llu-mt-8">{c.start}</p>
            </div>
            <div>
              <p class="llu-eyebrow">The result</p>
              <p class="llu-mt-8 llu-strong">{c.result}</p>
            </div>
            <a class="llu-link llu-link--cap" href={originals[c.key]} target="_blank" rel="noopener">
              Read {reviews[c.key].name.split(" ")[0]}'s LinkedIn review
            </a>
          </article>
        ))
      }
    </div>

    <div class="llu-head llu-mt-72">
      <p class="llu-eyebrow">The numbers</p>
      <h2 class="llu-h3">Raises, offers and time to hire, in their words.</h2>
    </div>
    <WinsGrid tone="dark" exclude={featured} class="llu-mt-48" />

    <div class="llu-row llu-mt-72">
      <a class="llu-card llu-video" href={VIDEO_URL} target="_blank" rel="noopener" data-llu-video={videoId} aria-label="Play the client video">
        <span class="llu-video__media">
          <LluImg img={videoThumb} alt="A ClearCareer client speaking on video" sizes="(min-width: 1024px) 524px, calc(100vw - 48px)" />
          <span class="llu-video__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          </span>
        </span>
        <span class="llu-video__body">
          <span class="llu-who__name">Hear it from clients, on video</span>
          <span class="llu-cap llu-block">Plays right here. Nothing loads from YouTube until you press play.</span>
        </span>
      </a>
      <LluReviewCard item={reviews.kristin} variant="big" />
    </div>

    <div class="llu-head llu-mt-72">
      <p class="llu-eyebrow">In their words</p>
      <h2 class="llu-h3">More from people I've coached.</h2>
    </div>
    <ReviewWall tone="dark" exclude={[...featured, ...winNames]} initial={9} batch={9} class="llu-mt-48" />

    <p class="llu-cap llu-center llu-mt-32">{NEW_PROGRAM_NOTE} {RESULTS_VARY}</p>
    <div class="llu-center-row llu-mt-48">
      <LluButton />
    </div>
  </div>
</section>

<script>
  // Click-to-load player: swap the thumbnail for YouTube's no-cookie player, in place.
  // Without JavaScript, the link still opens the video on YouTube.
  document.querySelectorAll<HTMLAnchorElement>("a[data-llu-video]").forEach((link) => {
    link.addEventListener("click", (e) => {
      const id = link.dataset.lluVideo;
      if (!id || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const card = document.createElement("div");
      card.className = "llu-card llu-video llu-video--playing";
      const frame = document.createElement("div");
      frame.className = "llu-video__frame";
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1&modestbranding=1`;
      iframe.title = "ClearCareer clients on video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      frame.appendChild(iframe);
      const body = link.querySelector(".llu-video__body");
      card.appendChild(frame);
      if (body) {
        const copy = body.cloneNode(true) as HTMLElement;
        copy.querySelector(".llu-cap")?.remove();
        card.appendChild(copy);
      }
      link.replaceWith(card);
      iframe.focus();
    });
  });
</script>

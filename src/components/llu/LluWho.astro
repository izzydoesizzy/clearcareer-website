---
import { roles } from "@/data/llu";
import LluFitArt from "./LluFitArt.astro";

const forYou = [
  "You're 3+ months in and the silence is getting loud.",
  "You don't know what to apply for, or what you're even qualified for.",
  "You're employed, undervalued, and done waiting to be noticed.",
  "You know you're good. Your resume and LinkedIn just aren't working.",
  "You'll try small, fast experiments instead of waiting to get it perfect.",
  "You see this as an investment in your next salary, not an expense.",
  "You want honest feedback, and you'll cheer on the people next to you.",
];
const notForYou = [
  "You keep tweaking your resume but never hit send.",
  "You wait to have complete clarity before taking a single step.",
  "You're waiting to feel confident first. Confidence comes after the first 10 messages.",
  "You take great notes on every call, then apply none of them.",
  "You've decided the system is rigged and you're not interested in learning how it works.",
  "You want someone to run your search. I'll help you build the system. You still drive it.",
  "You can't find a few hours a week, or you'll \"catch the replay\" instead of showing up live.",
];
---

<section class="llu-band llu-band--white" id="who">
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">Who it's for</p>
      <h2 class="llu-h2">From project managers to legal analysts.</h2>
      <p class="llu-lead">Experienced professionals between roles, in Canada and the US. Any field.</p>
    </div>

    <ul class="llu-chips llu-chips--center llu-mt-48">
      {roles.map((r, i) => <li class:list={["llu-chip", i % 5 === 0 && "llu-chip--solid"]}>{r}</li>)}
    </ul>
    <p class="llu-cap llu-center llu-mt-24">
      Roles of people I've coached, taken from their reviews, testimonials and profiles.
    </p>

    <div class="llu-row llu-row--top llu-mt-72">
      <div class="llu-fit llu-fit--yes">
        <LluFitArt kind="yes" />
        <h3 class="llu-fit__title">This is for you if</h3>
        <ul class="llu-fit__list">
          {forYou.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="llu-fit llu-fit--no">
        <LluFitArt kind="no" />
        <h3 class="llu-fit__title">It's not for you if</h3>
        <ul class="llu-fit__list">
          {notForYou.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
    <p class="llu-lead llu-center llu-mt-48">
      Not sure which side you're on? That's what the free call is for. Bring your questions, and you'll leave with a
      clear yes or no. <a class="llu-link" href="/book-a-call">Book a free call</a>
    </p>
  </div>
</section>

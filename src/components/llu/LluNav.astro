---
import { navLinks } from "@/data/llu";
import LluButton from "./LluButton.astro";
---

<header class="llu-nav">
  <div class="llu-wrap llu-nav__row">
    <nav class="llu-nav__links" aria-label="Sections">
      {navLinks.map((l) => <a class="llu-navlink" href={l.href}>{l.label}</a>)}
    </nav>
    <div class="llu-nav__right">
      <LluButton class="llu-nav__cta" />
    </div>
  </div>
</header>

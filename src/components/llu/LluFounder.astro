---
import LluImg from "./LluImg.astro";
import { reviews } from "@/data/llu";
import LluReviewCard from "./LluReviewCard.astro";
import { izzy, shots } from "./images";
---

<section class="llu-section llu-dark" id="izzy">
  <div class="llu-wrap">
    <div class="llu-grid llu-grid--split-rev">
      <div>
        <LluImg
          class="llu-img"
          img={izzy.sofa}
          alt="Izzy Piyale-Sheard, founder of ClearCareer, sitting on a sofa with a notebook"
          sizes="(min-width: 1024px) 440px, calc(100vw - 48px)"
        />
      </div>
      <div>
        <p class="llu-eyebrow">Who runs this</p>
        <h2 class="llu-h2 llu-mt-16">I built the room I wish I'd had.</h2>
        <div class="llu-stack llu-measure llu-mt-24">
          <p class="llu-lead">
            Hi, I'm Izzy. I'm a career zig-zagger and a jack-of-all-trades. For years I couldn't tell a coherent career
            story or show my value.
          </p>
          <p>
            I've been through long periods of unemployment. I felt unclear, confused and unmotivated, stuck in negative
            cycles that were hard to break.
          </p>
          <p>
            Then it clicked. My odd mix of skills was the value. Once I could say that clearly, opportunities started to
            show up.
          </p>
          <p>
            Since 2016, I've been building the support network I wished I had when I was struggling in silence. Land and
            Level Up is that room.
          </p>
        </div>
      </div>
    </div>

    <hr class="llu-rule llu-mt-72" />

    <div class="llu-grid llu-grid--split llu-mt-72">
      <div>
        <p class="llu-eyebrow">Where I've taught and been featured</p>
        <p class="llu-lead llu-measure llu-mt-16">
          I've run workshops for the University of Toronto, Toronto Metropolitan University and Humber College. Also for
          Lighthouse Labs, FlexJobs and the United Nations Association in Canada.
        </p>
        <p class="llu-measure llu-mt-16">
          My work has been featured on CBC's For What It's Worth, Global News, Newsweek and Inc. Magazine.
        </p>
        <dl class="llu-grid llu-grid--3 llu-mt-48">
          <div>
            <dt class="llu-stat__fig">200+</dt>
            <dd class="llu-stat__label">professionals coached one-on-one</dd>
            <dd class="llu-cap llu-mt-8">ClearCareer's own count, 2016 to today.</dd>
          </div>
          <div>
            <dt class="llu-stat__fig">2016</dt>
            <dd class="llu-stat__label">the year I started building this support network</dd>
            <dd class="llu-cap llu-mt-8">From my story on joinclearcareer.com.</dd>
          </div>
          <div>
            <dt class="llu-stat__fig">8 of 8</dt>
            <dd class="llu-stat__label">LinkedIn reviews are 5.0 stars</dd>
            <dd class="llu-cap llu-mt-8">Public reviews, January to March 2025.</dd>
          </div>
        </dl>
      </div>
      <figure>
        <LluImg
          class="llu-img"
          img={izzy.events}
          alt="Photos of Izzy at events and workshops, including Techweek New York, Microsoft and a classroom session"
          sizes="(min-width: 1024px) 440px, calc(100vw - 48px)"
        />
        <figcaption class="llu-cap llu-mt-16">Events, classrooms and workshops over the years.</figcaption>
      </figure>
    </div>

    <figure class="llu-shot llu-mt-72">
      <LluImg
        img={shots.raunika}
        alt={`LinkedIn review by Raunika L., 5.0 stars, ${reviews.raunika.date}`}
        sizes="880px"
      />
      <figcaption class="llu-cap llu-mt-16">
        Raunika L.'s review, exactly as it appears on LinkedIn. {reviews.raunika.date}.
      </figcaption>
    </figure>
    <div class="llu-shot-fallback llu-mt-48">
      <LluReviewCard item={reviews.raunika} tone="dark" />
    </div>
  </div>
</section>

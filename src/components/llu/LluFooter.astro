---
import { SURVEY_SOURCE, NEW_PROGRAM_NOTE, RESULTS_VARY } from "@/data/llu";
---

<footer class="llu-dark llu-footer">
  <div class="llu-wrap">
    <p class="llu-cap llu-measure">
      {RESULTS_VARY} {NEW_PROGRAM_NOTE} {SURVEY_SOURCE} Client reviews are public on LinkedIn. Other quotes are from
      ClearCareer clients, shared with first name and last initial.
    </p>
    <div class="llu-footer__links llu-mt-24">
      <span class="llu-cap llu-link--plain">© 2026 ClearCareer. joinclearcareer.com</span>
      <a class="llu-link llu-link--cap" href="/privacy">Privacy</a>
      <a class="llu-link llu-link--cap" href="/terms">Terms</a>
    </div>
  </div>
</footer>

---
import { CTA_LABEL } from "@/data/llu";

interface Props {
  href?: string;
  class?: string;
  external?: boolean;
}
const { href = "#pricing", class: className = "", external = false } = Astro.props;
---

<a
  class:list={["llu-btn", className]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
>{CTA_LABEL}</a>

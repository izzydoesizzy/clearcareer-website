---
/**
 * Two small looping animations for the "is it for you" cards. Pure CSS, no images.
 *   kind="yes": an inbox where "no reply" rows turn into interview requests.
 *   kind="no":  a "guaranteed job offer" ticket that gets stamped.
 * With reduced motion, each shows its final frame.
 */
interface Props { kind: "yes" | "no" }
const { kind } = Astro.props;
const rows = [
  ["Product Manager, fintech", "Interview Thursday at 2?"],
  ["Senior Project Manager", "Can we chat this week?"],
  ["Operations Lead", "Next step: meet the team"],
];
---

{
  kind === "yes" ? (
    <div class="fa fa--yes" aria-hidden="true">
      <div class="fa__win">
        <div class="fa__bar"><i /><i /><i /><span>Inbox</span></div>
        {rows.map(([role, reply], i) => (
          <div class="fa__row" style={`--i:${i}`}>
            <span class="fa__old"><b class="fa__dot" /><span class="fa__txt">{role}</span><em>No reply</em></span>
            <span class="fa__new"><b class="fa__dot fa__dot--on" /><span class="fa__txt">{reply}</span><em class="fa__tick">✓</em></span>
          </div>
        ))}
      </div>
      <span class="fa__badge">+3</span>
    </div>
  ) : (
    <div class="fa fa--no" aria-hidden="true">
      <div class="fa__ticket">
        <span class="fa__ticket-top">Guaranteed</span>
        <span class="fa__ticket-big">Job offer</span>
        <span class="fa__ticket-small">No effort required</span>
      </div>
      <span class="fa__stamp">No one can promise that</span>
    </div>
  )
}

<style>
  .fa {
    position: relative; height: 200px; border-radius: 16px; overflow: hidden;
    display: grid; place-items: center;
  }
  .fa--yes { background: linear-gradient(160deg, #e8f0ff, #f5f8ff); }
  .fa--no { background: linear-gradient(160deg, #f3efe8, #faf8f4); }

  /* Inbox */
  .fa__win {
    width: min(86%, 340px); background: #fff; border-radius: 12px; overflow: hidden;
    box-shadow: 0 10px 30px rgb(3 6 32 / 0.12); font: 500 12.5px/1.2 var(--llu-sans, system-ui);
  }
  .fa__bar { display: flex; align-items: center; gap: 5px; padding: 8px 10px; background: #f3f4f6; color: #6b7280; font-size: 11px; }
  .fa__bar i { width: 8px; height: 8px; border-radius: 99px; background: #d1d5db; }
  .fa__bar span { margin-left: 6px; }
  .fa__row { position: relative; height: 36px; border-top: 1px solid #f1f1f1; }
  .fa__old, .fa__new { position: absolute; inset: 0; display: flex; align-items: center; gap: 8px; padding: 0 12px; white-space: nowrap; overflow: hidden; }
  .fa__old { color: #9ca3af; }
  .fa__new { color: #030620; background: #f2f7ff; opacity: 0; }
  .fa__old em, .fa__new em { margin-left: auto; flex: none; font-style: normal; font-size: 11px; }
  .fa__txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .fa__dot { width: 8px; height: 8px; border-radius: 99px; background: #d1d5db; flex: none; }
  .fa__dot--on { background: #0161ef; }
  .fa__tick { color: #fff; background: #0161ef; border-radius: 99px; width: 18px; height: 18px; display: grid; place-items: center; font-size: 11px; }
  .fa__badge {
    position: absolute; top: 18px; right: 22px; background: #0161ef; color: #fff; font: 700 14px/1 var(--llu-sans, system-ui);
    padding: 8px 10px; border-radius: 99px; box-shadow: 0 6px 16px rgb(1 97 239 / 0.35); opacity: 0;
  }

  /* Ticket and stamp */
  .fa__ticket {
    display: grid; gap: 4px; text-align: center; padding: 18px 34px; border-radius: 14px;
    background: linear-gradient(135deg, #ffe9a8, #ffd15c); color: #5a3d00;
    box-shadow: 0 10px 30px rgb(90 61 0 / 0.18); border: 2px dashed rgb(90 61 0 / 0.35);
    font-family: var(--llu-sans, system-ui);
  }
  .fa__ticket-top { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .fa__ticket-big { font: 400 30px/1 var(--llu-serif, Georgia, serif); color: #3a2700; }
  .fa__ticket-small { font-size: 12px; }
  .fa__stamp {
    position: absolute; padding: 8px 14px; border: 3px solid #c2392b; border-radius: 8px; color: #c2392b;
    font: 800 15px/1.1 var(--llu-sans, system-ui); text-transform: uppercase; letter-spacing: 0.06em;
    background: rgb(255 255 255 / 0.85); transform: rotate(-9deg); opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fa__new { animation: fa-reply 9s ease-in-out infinite; animation-delay: calc(var(--i) * 0.7s); }
    .fa__old { animation: fa-old 9s ease-in-out infinite; animation-delay: calc(var(--i) * 0.7s); }
    .fa__badge { animation: fa-badge 9s ease-in-out infinite; }
    .fa__ticket { animation: fa-float 6s ease-in-out infinite; }
    .fa__stamp { animation: fa-stamp 6s ease-in infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fa__new { opacity: 1; }
    .fa__old { opacity: 0; }
    .fa__badge, .fa__stamp { opacity: 1; }
  }
  @keyframes fa-reply { 0%, 22% { opacity: 0; transform: translateY(8px); } 30%, 88% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes fa-old { 0%, 22% { opacity: 1; } 30%, 88% { opacity: 0; } 96%, 100% { opacity: 1; } }
  @keyframes fa-badge { 0%, 52% { opacity: 0; transform: scale(0.4); } 58% { opacity: 1; transform: scale(1.15); } 62%, 88% { opacity: 1; transform: scale(1); } 96%, 100% { opacity: 0; } }
  @keyframes fa-float { 0%, 100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-6px) rotate(1deg); } }
  @keyframes fa-stamp {
    0%, 30% { opacity: 0; transform: rotate(-9deg) scale(2.4); }
    38% { opacity: 1; transform: rotate(-9deg) scale(0.94); }
    42%, 86% { opacity: 1; transform: rotate(-9deg) scale(1); }
    94%, 100% { opacity: 0; transform: rotate(-9deg) scale(1); }
  }
</style>

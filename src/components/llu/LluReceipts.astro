---
/**
 * Real screenshots clients sent Izzy when it happened (clearcareer-ops/marketing/testimonials).
 * Client names, photos and contact details are blurred, as are third parties (recruiters, phone
 * numbers, emails). Swearing in Izzy's replies is blurred too. Each headline restates what the
 * screenshot itself shows.
 */
const receipts = [
  { src: "henrique", w: 640, h: 867, title: "$80K to $115K in one week", alt: "Text messages: a client shares an offer of $115K plus 10% and asks for help negotiating to $120K. Izzy replies: $80K to $115K in 1 week." },
  { src: "septembre", w: 640, h: 609, title: "Two interview requests overnight", alt: "A tweet: I applied for a few jobs last night and I woke up to two emails in my inbox asking for interviews. This new resume is getting noticed." },
  { src: "annie", w: 640, h: 214, title: "200% more, after learning to negotiate", alt: "A message: I'm making over 200% more since learning how to negotiate." },
  { src: "victor", w: 640, h: 1017, title: "3 interviews in 2 weeks", alt: "WhatsApp: a client forwards a screening invite, then writes: your changes to my resume and LinkedIn profile have made a significant impact. 3 interviews in 2 week span." },
  { src: "danica", w: 640, h: 249, title: "The interviewer noticed the numbers", alt: "A Discord message: during the interview she said she really appreciated how I included in my resume how much money and time I saved my companies." },
  { src: "blake", w: 640, h: 1012, title: "+$5,000 just by asking", alt: "WhatsApp: a client says they said 83,250 won't work but 80,000 will, the job search is over after 9 months, and an extra 5 grand just by asking for it." },
  { src: "tiana", w: 640, h: 436, title: "A next-step email within an hour", alt: "Chat: I updated my resume yesterday to your feedback and got a next step email this morning for a manager level role. Within an hour." },
  { src: "jorge", w: 640, h: 853, title: "A third interview, an hour after one email", alt: "Text messages: an hour after I sent the email I got a reply for a third interview tomorrow with the General Manager. Izzy reminds the client to come prepared with salary." },
  { src: "views", w: 640, h: 449, title: "LinkedIn profile views up 300%", alt: "A LinkedIn chart: average profile views went from 16 to 65 or more a week after a new banner, headshot, About section and headline." },
  { src: "mazia", w: 640, h: 459, title: "Still quoting her follow-up email", alt: "Text messages: a hiring manager says I still reference your follow-up email in internal meetings all the time. They still want me to interview with them." },
];
---

<section class="llu-band" id="receipts">
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">The receipts</p>
      <h2 class="llu-h2">Real messages from real clients.</h2>
      <p class="llu-lead">Texts, DMs and emails they sent me the day it happened.</p>
    </div>

    <div class="rc llu-mt-72" role="list">
      {
        receipts.map((r) => (
          <figure class="rc__card" role="listitem">
            <figcaption class="rc__title">{r.title}</figcaption>
            <img
              src={`/images/llu/receipts/${r.src}.webp`}
              width={r.w}
              height={r.h}
              alt={r.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
    <p class="llu-cap llu-center llu-mt-24">
      Screenshots from 2020 to 2024. Names, faces and contact details blurred for privacy. Results vary.
    </p>
  </div>
</section>

<style>
  /* Phones: one swipeable row. Larger screens: a staggered grid. */
  .rc {
    display: flex; align-items: flex-start; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    margin: 0 -24px; padding: 0 24px 12px; scrollbar-width: thin;
  }
  .rc__card { flex: 0 0 80%; scroll-snap-align: start; }
  @media (min-width: 768px) {
    .rc { display: block; columns: 2; column-gap: 24px; overflow: visible; margin: 0; padding: 0; }
    .rc__card { break-inside: avoid; margin: 0 0 24px; }
  }
  @media (min-width: 1024px) { .rc { columns: 3; } }
  .rc__card {
    display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 16px;
    border-radius: 20px; background: var(--llu-white); border: 1px solid var(--llu-hairline);
    box-shadow: 0 1px 2px rgb(3 6 32 / 0.06);
  }
  .rc__title { font-weight: 700; font-size: 17px; line-height: 1.3; color: var(--llu-ink); padding: 4px 4px 0; }
  .rc__card img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--llu-hairline); }
</style>

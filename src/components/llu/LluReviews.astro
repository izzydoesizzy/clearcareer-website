---
import LluImg from "./LluImg.astro";
import { reviews, RESULTS_VARY, NEW_PROGRAM_NOTE } from "@/data/llu";
import LluReviewCard from "./LluReviewCard.astro";
import { shots } from "./images";

const grid = [reviews.darin, reviews.laura, reviews.tamara, reviews.kira];
---

<section class="llu-section" id="proof">
  <div class="llu-wrap">
    <p class="llu-eyebrow">What happened next</p>
    <h2 class="llu-h2 llu-mt-16">Then they stopped doing it alone.</h2>
    <p class="llu-lead llu-measure llu-mt-24">
      These are public LinkedIn reviews from people I've coached. Their words, not mine. Find the one who started
      where you are.
    </p>

    <div class="llu-mt-48">
      <span class="llu-tag">Started from: {reviews.sparsh.startingPoint.toLowerCase()}</span>
      <figure class="llu-shot llu-mt-16">
        <LluImg
          img={shots.sparsh}
          alt={`LinkedIn review by Sparsh K., 5.0 stars, ${reviews.sparsh.date}: “${reviews.sparsh.before}${reviews.sparsh.mark}${reviews.sparsh.after}”`}
          sizes="880px"
        />
        <figcaption class="llu-cap llu-mt-16">
          Sparsh K.'s review, exactly as it appears on LinkedIn. {reviews.sparsh.date}.
        </figcaption>
      </figure>
      <div class="llu-shot-fallback llu-mt-16">
        <LluReviewCard item={reviews.sparsh} />
      </div>
    </div>

    <div class="llu-grid llu-grid--2 llu-mt-32">
      {grid.map((r) => <LluReviewCard item={r} tag={`Started from: ${r.startingPoint.toLowerCase()}`} />)}
    </div>

    <p class="llu-cap llu-measure llu-mt-32">{NEW_PROGRAM_NOTE} {RESULTS_VARY}</p>
  </div>
</section>

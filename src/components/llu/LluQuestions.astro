---
import { questions } from "@/data/llu";

const ways = [
  { label: "Ask the room", body: "Post it in the community. People in the same spot answer, and so do I." },
  { label: "Bring it Wednesday", body: "One live hour a week. Put your question in front of the whole group." },
  { label: "Take the hot seat", body: "In the rebuild workshop, we rework a member's resume live. It could be yours." },
];
---

<section class="llu-band llu-band--blue" id="room">
  <div class="llu-wrap">
    <div class="llu-measure">
      <p class="llu-eyebrow">What it's like inside</p>
      <h2 class="llu-h2 llu-mt-16">The questions you can't ask at dinner.</h2>
      <p class="llu-lead llu-mt-24">
        Your family loves you. They don't know what a fair offer looks like. In here, someone does.
      </p>
    </div>

    <ul class="llu-chips llu-mt-48">
      {questions.map((q, i) => <li class:list={["llu-chip llu-chip--lg", i % 3 === 1 && "llu-chip--alt"]}>{q}</li>)}
    </ul>

    <div class="llu-ruled llu-ruled--3 llu-mt-72">
      {
        ways.map((w) => (
          <div>
            <p class="llu-eyebrow">{w.label}</p>
            <p class="llu-mt-8">{w.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

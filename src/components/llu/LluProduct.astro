---
import LluImg from "./LluImg.astro";
import { quotes, survey, SURVEY_SOURCE } from "@/data/llu";
import LluReviewCard from "./LluReviewCard.astro";
import { profiles } from "./images";
---

<section class="llu-section" id="inside">
  <div class="llu-wrap">
    <p class="llu-eyebrow">What you get</p>
    <h2 class="llu-h2 llu-mt-16">Here's what's inside, and what it looks like.</h2>
    <p class="llu-lead llu-measure llu-mt-24">
      Four things. The first three come with every seat. The fourth is Concierge only.
    </p>

    <!-- 01 The rebuild -->
    <div class="llu-feature">
      <div>
        <p class="llu-eyebrow"><span class="llu-num">01</span> · Every seat</p>
        <h3 class="llu-h3 llu-mt-16">Your resume and LinkedIn, rebuilt with me.</h3>
        <div class="llu-stack llu-mt-24">
          <p>
            We do this 1:1. I ask about your work until we find the numbers. Then we rewrite your resume and your
            LinkedIn around them.
          </p>
          <p>
            Look at Eblen's headline. Before: “Customer-Obsessed & Value-Driven.” After: $850K in contract value, 140+
            go-lives and a 30% retention increase.
          </p>
        </div>
        <p class="llu-stat__fig llu-mt-32">{survey.resumeSupportRating.toFixed(2)} out of 5</p>
        <p class="llu-stat__label">How past members rated my resume support.</p>
        <p class="llu-cap llu-mt-8">{SURVEY_SOURCE}</p>
        <div class="llu-mt-32">
          <LluReviewCard item={quotes.victor} />
        </div>
      </div>
      <div>
        <figure class="llu-card llu-ui">
          <figcaption class="llu-ui__bar">
            <span class="llu-title">Eblen G., customer success manager</span>
            <span class="llu-cap">Real LinkedIn profile, before and after</span>
          </figcaption>
          <div class="llu-ui__body">
            <div class="llu-stack-32">
              <div>
                <span class="llu-chip">Before</span>
                <LluImg
                  class="llu-img llu-mt-16"
                  img={profiles.eblenBefore}
                  alt="Eblen G.'s LinkedIn profile before: a stock banner and a headline with no numbers"
                  sizes="(min-width: 1024px) 560px, calc(100vw - 96px)"
                />
                <p class="llu-cap llu-mt-16">
                  “Customer Success Manager | Customer-Obsessed & Value-Driven | 7+ Years Building Relationships &
                  Driving Success”
                </p>
              </div>
              <div>
                <span class="llu-chip llu-chip--solid">After</span>
                <LluImg
                  class="llu-img llu-mt-16"
                  img={profiles.eblenAfter}
                  alt="Eblen G.'s LinkedIn profile after: a custom banner and a headline with results"
                  sizes="(min-width: 1024px) 560px, calc(100vw - 96px)"
                />
                <p class="llu-mt-16 llu-strong">
                  “Customer Success Manager | 5+ Years in SaaS & Marketing | Delivered $850K in Total Contract Value |
                  Drove 140+ Go-Lives & Achieved 30% Client Retention Increase”
                </p>
              </div>
            </div>
          </div>
        </figure>
      </div>
    </div>

    <!-- 02 The Wednesday call -->
    <div class="llu-feature">
      <div>
        <p class="llu-eyebrow"><span class="llu-num">02</span> · Every seat</p>
        <h3 class="llu-h3 llu-mt-16">A live group call, every Wednesday.</h3>
        <div class="llu-stack llu-mt-24">
          <p>One hour, live, with me and the rest of the founding group. 20 people at most.</p>
          <p>
            You bring what happened this week. We fix what isn't working, and you leave knowing what to do before next
            Wednesday.
          </p>
        </div>
        <p class="llu-stat__fig llu-mt-32">{survey.weeklyCallsRating.toFixed(2)} out of 5</p>
        <p class="llu-stat__label">How past members rated my weekly calls.</p>
        <p class="llu-cap llu-mt-8">{SURVEY_SOURCE}</p>
      </div>
      <div class="llu-card llu-ui">
        <div class="llu-ui__bar">
          <span class="llu-title">Wednesday group call</span>
          <span class="llu-chips">
            <span class="llu-chip llu-chip--solid">Live</span>
            <span class="llu-chip">60 minutes</span>
            <span class="llu-chip">Every week</span>
          </span>
        </div>
        <div class="llu-ui__body">
          <div class="llu-pair">
            <div>
              <p class="llu-eyebrow">You bring</p>
              <ul class="llu-list llu-mt-16">
                <li>The offer you're weighing</li>
                <li>The rejection that stung</li>
                <li>The point where you're stuck</li>
              </ul>
            </div>
            <div>
              <p class="llu-eyebrow">You leave with</p>
              <ul class="llu-list llu-mt-16">
                <li>A plan for the week</li>
                <li>Feedback from people in the same spot</li>
                <li>A reason to show up next Wednesday</li>
              </ul>
            </div>
          </div>
          <hr class="llu-rule llu-mt-24" />
          <p class="llu-cap llu-mt-16">First call: Wednesday, December 9, 2026. Hosted by Izzy.</p>
        </div>
      </div>
    </div>

    <!-- 03 AI Achievement Interviewer -->
    <div class="llu-feature">
      <div>
        <p class="llu-eyebrow"><span class="llu-num">03</span> · Every seat</p>
        <h3 class="llu-h3 llu-mt-16">The AI Achievement Interviewer.</h3>
        <div class="llu-stack llu-mt-24">
          <p>
            Most people can't list their own wins. So this tool interviews you, one question at a time, until your work
            has numbers on it.
          </p>
          <p>We use what it finds in your rebuild and in your interviews.</p>
        </div>
        <p class="llu-stat__fig llu-mt-32">{survey.aiPromptsRating.toFixed(2)} out of 5</p>
        <p class="llu-stat__label">How past members rated my AI prompts.</p>
        <p class="llu-cap llu-mt-8">{SURVEY_SOURCE}</p>
      </div>
      <figure class="llu-card llu-ui">
        <div class="llu-ui__bar">
          <span class="llu-title">AI Achievement Interviewer</span>
          <span class="llu-chip">Illustration</span>
        </div>
        <div class="llu-ui__body llu-stack">
          <p class="llu-bubble">What did you own in your last role?</p>
          <p class="llu-bubble llu-bubble--you">Vendor contracts for our region.</p>
          <p class="llu-bubble">How many? And what did you change?</p>
          <p class="llu-bubble llu-bubble--you">About 40. I renegotiated the five biggest.</p>
          <p class="llu-bubble">What did that save in a year?</p>
          <div class="llu-bubble llu-bubble--out">
            <p class="llu-cap">Drafted for your resume</p>
            <p class="llu-mt-8">An achievement line with your numbers in it, ready for us to sharpen together.</p>
          </div>
        </div>
        <figcaption class="llu-cap llu-ui__foot">
          Illustration of the format. Not a real transcript.
        </figcaption>
      </figure>
    </div>

    <!-- 04 Concierge -->
    <div class="llu-feature">
      <div>
        <p class="llu-eyebrow"><span class="llu-num">04</span> · Concierge only</p>
        <h3 class="llu-h3 llu-mt-16">Roles picked for you. A resume for each.</h3>
        <div class="llu-stack llu-mt-24">
          <p>
            Every week I send you a shortlist of roles that fit. Each one comes with a resume tailored to that role.
          </p>
          <p>You also get a 1:1 with me every month. Five seats, by application.</p>
        </div>
      </div>
      <figure class="llu-card llu-ui">
        <div class="llu-ui__bar">
          <span class="llu-title">Your shortlist this week</span>
          <span class="llu-chip">Illustration</span>
        </div>
        <div class="llu-ui__body">
          <div class="llu-ui__row">
            <div>
              <p class="llu-strong">Senior Customer Success Manager</p>
              <p class="llu-cap">Remote, Canada</p>
            </div>
            <span class="llu-chip llu-chip--solid">Resume tailored</span>
          </div>
          <div class="llu-ui__row">
            <div>
              <p class="llu-strong">Director, Client Operations</p>
              <p class="llu-cap">Toronto, hybrid</p>
            </div>
            <span class="llu-chip llu-chip--solid">Resume tailored</span>
          </div>
          <div class="llu-ui__row">
            <div>
              <p class="llu-strong">Head of Customer Experience</p>
              <p class="llu-cap">Remote, US</p>
            </div>
            <span class="llu-chip">In progress</span>
          </div>
        </div>
        <figcaption class="llu-cap llu-ui__foot">
          Illustration. Your shortlist is built around the roles you're targeting.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

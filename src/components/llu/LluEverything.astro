---
/**
 * Everything a member gets. Support first, then the toolkit.
 * Every item comes from a past ClearCareer group program (old community page, 2024 membership,
 * 2024 network) or this program's own offer (src/data/llu.ts). No 1:1 or done-for-you items:
 * those belong to the private rebuild only.
 */
import { offer, survey, toolkit } from "@/data/llu";

const support = [
  {
    icon: "check",
    title: "Accountability",
    body: "Every week you share your top 3 priorities with the group. On Wednesday, we check in.",
  },
  {
    icon: "people",
    title: "People in your corner",
    body: `${offer.seatsTotal} people at most, all searching right now. Share wins, vent, ask "is this normal?"`,
  },
  {
    icon: "battery",
    title: "Energy back",
    body: "Leave every call with a plan and your batteries recharged. The search stops feeling like a weight you carry alone.",
  },
  {
    icon: "target",
    title: "Interviews, not silence",
    body: "Clear targets, a resume and LinkedIn that show your value, and emails to the people who actually hire.",
  },
];

const kit = [
  {
    label: "Live with me",
    items: [
      `6 Wednesday group calls (${offer.callDates.replace(", then", ",")})`,
      "Resume and LinkedIn rebuild workshop, with hot seats",
      "Every call recorded, summarized and searchable",
    ],
  },
  {
    label: "Go direct",
    items: [
      "How to find the hiring managers at your target companies",
      "How to find their email addresses",
      "Email templates for hiring managers, follow-ups and the \"silver bullet\" thank-you",
      "Feedback on your emails before you hit send",
    ],
  },
  {
    label: "AI that does the heavy lifting",
    items: [
      `${toolkit.skillCount} Claude skills, one for every step of your search`,
      `The ${toolkit.suiteCount}-tool Career Suite, including the AI Achievement Interviewer and Job Search Autopilot`,
      "AI research on your target companies and the people who hire",
    ],
  },
  {
    label: "Systems to work faster",
    items: [
      "Target company list and job search tracker",
      "Weekly priorities and progress system",
      "Resume templates and salary negotiation frameworks",
      "Resource library, plus every ClearCareer tool and when to use it",
    ],
  },
];

const icons: Record<string, string> = {
  check: '<path d="M20 6 9 17l-5-5" />',
  people: '<circle cx="9" cy="8" r="3.2" /><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5" /><circle cx="17.5" cy="9" r="2.6" /><path d="M16.5 14.6c2.6.2 4.4 1.9 5 5.4" />',
  battery: '<rect x="2" y="7" width="17" height="10" rx="2" /><path d="M22 11v2" /><path d="M10 9.5 8 12h4l-2 2.5" />',
  target: '<circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" />',
};
---

<section class="llu-band" id="everything">
  <span id="inside" class="ev-anchor" aria-hidden="true"></span>
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">Everything you get</p>
      <h2 class="llu-h2">You won't do this alone. Or from scratch.</h2>
      <p class="llu-lead">The support comes first. Then every template, prompt and tool I've built for my clients.</p>
    </div>

    <div class="ev-support llu-mt-72">
      {
        support.map((s) => (
          <div class="ev-support__card">
            <span class="ev-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            </span>
            <h3 class="ev-support__title">{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="ev-kit llu-mt-48">
      <div class="ev-kit__main">
        <p class="llu-eyebrow">Your toolkit</p>
        <h3 class="llu-h3 llu-mt-8">What comes with your seat</h3>
        <div class="ev-kit__groups">
          {
            kit.map((g) => (
              <div>
                <p class="ev-kit__label">{g.label}</p>
                <ul class="ev-kit__list">
                  {g.items.map((i) => (
                    <li>
                      <span class="ev-tick" aria-hidden="true">✓</span>
                      {i}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="llu-cap ev-kit__foot">
          {survey.savesHourPct}% of past clients I surveyed save an hour or more a week. Choose the
          private rebuild and I also do the heavy lifting for you: I draft your resume and LinkedIn, build your target
          company and hiring manager lists, and research your salary numbers. Then we polish it all 1:1 before the
          holidays. <a class="llu-link" href="#toolkit">See every tool</a> or
          <a class="llu-link" href="#pricing">compare options</a>
        </p>
      </div>

      <figure class="ev-shot">
        <img
          src="/images/llu/community-wins-560.webp"
          srcset="/images/llu/community-wins-560.webp 560w, /images/llu/community-wins-1024.webp 1024w"
          sizes="(min-width: 1024px) 400px, calc(100vw - 48px)"
          width="1024"
          height="1024"
          loading="lazy"
          decoding="async"
          alt="A past ClearCareer community: a 'Share your wins' feed with posts titled 'Landed an interview yesterday', 'Job offer, signed!' and 'Yippeee!'"
        />
        <figcaption class="llu-cap">A past ClearCareer community, 2024. Names and faces blurred for privacy.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .ev-anchor { display: block; position: relative; top: -72px; }
  .ev-support { display: grid; gap: var(--llu-gap); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .ev-support { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .ev-support { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ev-support__card {
    display: flex; flex-direction: column; gap: 10px; padding: 24px;
    border-radius: 20px; background: var(--llu-white); border: 1px solid var(--llu-hairline);
  }
  .ev-support__card p { margin: 0; color: var(--llu-body); }
  .ev-support__title { margin: 6px 0 0; font-size: 20px; line-height: 1.25; font-weight: 700; color: var(--llu-ink); }
  .ev-icon {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px;
    background: #e8f0ff; color: var(--llu-blue);
  }

  .ev-kit {
    display: grid; gap: 40px; grid-template-columns: minmax(0, 1fr); align-items: center;
    padding: 32px; border-radius: 24px; background: var(--llu-white); border: 1px solid var(--llu-hairline);
  }
  @media (min-width: 1024px) { .ev-kit { grid-template-columns: minmax(0, 1fr) 400px; padding: 48px; gap: 56px; } }
  .ev-kit__groups { display: grid; gap: 28px 40px; margin-top: 32px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .ev-kit__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ev-kit__label {
    margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--llu-blue);
  }
  .ev-kit__list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .ev-kit__list li { display: flex; gap: 10px; align-items: flex-start; color: var(--llu-ink); line-height: 1.45; }
  .ev-tick {
    flex: none; display: grid; place-items: center; width: 20px; height: 20px; margin-top: 2px;
    border-radius: 999px; background: var(--llu-blue); color: #fff; font-size: 11px; font-weight: 700;
  }
  .ev-kit__foot { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--llu-hairline); }
  .ev-shot { margin: 0; display: grid; gap: 12px; }
  .ev-shot img { width: 100%; height: auto; border-radius: 20px; }
</style>

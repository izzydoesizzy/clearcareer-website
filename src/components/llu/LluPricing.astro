---
import { offer, CTA_LABEL, GROUP_CHECKOUT_URL, PRIVATE_CHECKOUT_URL } from "@/data/llu";

const tiers = [
  { t: offer.group, href: GROUP_CHECKOUT_URL, lead: true },
  { t: offer.private, href: PRIVATE_CHECKOUT_URL, lead: false },
];
---

<section class="llu-band llu-band--navy" id="pricing">
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">Black Friday pricing, until {offer.dealEndsShort}</p>
      <h2 class="llu-h2">Choose your room.</h2>
      <p class="llu-lead">These are Black Friday prices. {offer.regularFrom}</p>
      <p class="llu-lead">“{offer.dealLine}”</p>
    </div>

    <dl class="llu-ruled llu-ruled--3 llu-mt-72">
      <div>
        <dt class="llu-stat__fig">$8,333</dt>
        <dd class="llu-stat__label">One month of a $100,000 salary, before tax.</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">5.5 months</dt>
        <dd class="llu-stat__label">Average time unemployed in the US (Bureau of Labor Statistics, 2025).</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">{offer.group.price}</dt>
        <dd class="llu-stat__label">The group cohort at the Black Friday price, for your first 3 months. CAD plus HST.</dd>
      </div>
    </dl>

    <div class="llu-grid llu-grid--2 llu-mt-48">
      {
        tiers.map(({ t, href, lead }) => (
          <div class:list={["llu-surface llu-tier", lead && "llu-tier--lead"]}>
            <div>
              <p class="llu-eyebrow">{t.name}</p>
              <p class="llu-tier__price llu-mt-16">
                {t.price} <s class="llu-strike">{t.regular}</s>
              </p>
              <p class="llu-bf llu-mt-8">Black Friday price, regular {t.regular}</p>
              <p class="llu-cap llu-mt-8">{t.priceNote}</p>
            </div>
            <div class="llu-tier__for">
              <p class="llu-eyebrow">Who it's for</p>
              <p class="llu-strong llu-mt-8">{t.forWho}</p>
            </div>
            <ul class="llu-list llu-tier__grow">
              {t.includes.map((i) => <li>{i}</li>)}
            </ul>
            <div>
              <a class="llu-btn llu-btn--wide" href={href} target="_blank" rel="noopener">{CTA_LABEL}</a>
              <p class="llu-cap llu-mt-16">
                <span class="llu-num">{t.seatsLeft} of {t.seatsTotal}</span> seats left. {t.regular} plus HST from
                December 1.
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="llu-ruled llu-ruled--3 llu-mt-48">
      <div>
        <p class="llu-eyebrow">The deadline</p>
        <p class="llu-mt-8">Black Friday pricing ends {offer.dealEndsLong}. No extensions.</p>
      </div>
      <div>
        <p class="llu-eyebrow">Ways to pay</p>
        <p class="llu-mt-8">{offer.paying}</p>
      </div>
      <div>
        <p class="llu-eyebrow">After month 3</p>
        <p class="llu-mt-8">{offer.afterThreeMonths}</p>
      </div>
    </div>

    <div class="llu-card llu-mt-72" id="guarantee">
      <div class="llu-row llu-row--top">
        <div>
          <p class="llu-eyebrow">The guarantee</p>
          <h3 class="llu-h3 llu-mt-16">Seven days to change your mind.</h3>
        </div>
        <div class="llu-stack">
          <p>
            If it isn't right for you, email me at izzy@joinclearcareer.com within 7 days of joining. I'll refund every
            dollar.
          </p>
          <p>
            <span class="llu-strong">One condition.</span> The guarantee ends once your rebuild work has started, in the
            workshop or 1:1. I can't take that work back.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

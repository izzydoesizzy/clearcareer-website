---
import { offer, CTA_LABEL, GROUP_CHECKOUT_URL, PRIVATE_CHECKOUT_URL, survey, SURVEY_SOURCE } from "@/data/llu";

const tiers = [
  { t: offer.group, href: GROUP_CHECKOUT_URL, lead: true },
  { t: offer.private, href: PRIVATE_CHECKOUT_URL, lead: false },
];
---

<section class="llu-band llu-band--navy" id="pricing">
  <div class="llu-wrap">
    <div class="llu-head">
      <p class="llu-eyebrow">{offer.dealLive ? <>Black Friday pricing<span class="llu-md-only">, until {offer.dealEndsShort}</span></> : "Pricing"}</p>
      <h2 class="llu-h2">Choose your room.</h2>
      {offer.dealLive && <p class="llu-lead">Use code <strong class="llu-code">{offer.promoCode}</strong> at checkout for 20% off. {offer.regularFrom}</p>}
      {offer.dealLive && <p class="llu-lead">“{offer.dealLine}”</p>}
    </div>

    <dl class="llu-ruled llu-ruled--3 llu-mt-72">
      <div>
        <dt class="llu-stat__fig">$8,333</dt>
        <dd class="llu-stat__label">One month of a $100,000 salary, before tax.</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">5.5 months</dt>
        <dd class="llu-stat__label">Average time unemployed in the US (Bureau of Labor Statistics, 2025).</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">{offer.group.price}</dt>
        <dd class="llu-stat__label">{offer.dealLive ? "The group cohort with code BLACKFRIDAY, for the full 6 weeks." : "The group cohort, for the full 6 weeks."} CAD plus HST.</dd>
      </div>
    </dl>

    <div class="llu-grid llu-grid--2 llu-grid--wide-cards llu-mt-48">
      {
        tiers.map(({ t, href, lead }) => (
          <div class:list={["llu-surface llu-tier", lead && "llu-tier--lead"]}>
            <div>
              <p class="llu-eyebrow">{t.name}</p>
              <p class="llu-tier__mode llu-mt-8"><span class="llu-tier__label">{t.mode}</span> {t.modeLine}</p>
              <p class="llu-tier__price llu-mt-16">
                {t.price} {offer.dealLive && <s class="llu-strike">{t.regular}</s>}
              </p>
              {offer.dealLive && <p class="llu-bf llu-mt-8">20% off with code <strong class="llu-code">{offer.promoCode}</strong>. Regular {t.regular}.</p>}
              <p class="llu-cap llu-mt-8">{t.priceNote}</p>
            </div>
            <div class="llu-tier__for">
              <p class="llu-eyebrow">Who it's for</p>
              <p class="llu-strong llu-mt-8">{t.forWho}</p>
            </div>
            <ul class="llu-list llu-tier__grow">
              {t.includes.map((i) => <li>{i}</li>)}
              {lead && <li>Plus call recordings, templates, scripts and trackers. <a class="llu-link" href="#toolkit">See every tool</a></li>}
            </ul>
            <div>
              <a class="llu-btn llu-btn--wide" href={href} {...(href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{href.startsWith("http") ? CTA_LABEL : "Book your free fit call"}</a>
              <p class="llu-cap llu-mt-16">
                <span class="llu-num">{t.seatsLeft} of {t.seatsTotal}</span> seats left.{offer.dealLive && <>{" "}{t.regular} plus HST from December 1.</>}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="llu-ruled llu-ruled--3 llu-mt-48">
      <div>
        <p class="llu-eyebrow">{offer.dealLive ? "The deadline" : "When we start"}</p>
        <p class="llu-mt-8">{offer.dealLive ? `Black Friday pricing ends ${offer.dealEndsLong}. No extensions.` : `${offer.startDateLong}.`}</p>
      </div>
      <div>
        <p class="llu-eyebrow">Ways to pay</p>
        <p class="llu-mt-8">{offer.paying}</p>
      </div>
      <div>
        <p class="llu-eyebrow">After the 6 weeks</p>
        <p class="llu-mt-8">{offer.afterProgram}</p>
      </div>
    </div>

    <div class="llu-head llu-mt-72">
      <p class="llu-eyebrow">What past clients got out of it</p>
    </div>
    <dl class="llu-ruled llu-ruled--3 llu-mt-32">
      <div>
        <dt class="llu-stat__fig">{survey.raises20kPlus} people</dt>
        <dd class="llu-stat__label">got raises of $20K or more. {survey.raises50kPlus} went past $50K, and {survey.raises100kPlus} past $100K.</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">{survey.stuckLandedPct}%</dt>
        <dd class="llu-stat__label">of the {survey.stuck6PlusMonths} who'd been stuck for over six months landed after joining.</dd>
      </div>
      <div>
        <dt class="llu-stat__fig">{Math.round((survey.raisedPay / survey.landed) * 100)}%</dt>
        <dd class="llu-stat__label">of those who landed a role raised their pay.</dd>
      </div>
    </dl>
    <p class="llu-cap llu-center llu-mt-24">{SURVEY_SOURCE} Results vary. <a class="llu-link" href="/outcomes">See the full outcomes report</a></p>

    <div class="llu-card llu-mt-72" id="guarantee">
      <div class="llu-row llu-row--top">
        <div>
          <p class="llu-eyebrow">The guarantee</p>
          <h3 class="llu-h3 llu-mt-16">Seven days to change your mind.</h3>
        </div>
        <div class="llu-stack">
          <p>
            If it isn't right for you, email me at izzy@joinclearcareer.com within 7 days of joining. I'll refund every
            dollar.
          </p>
          <p>
            <span class="llu-strong">One condition.</span> The guarantee ends once your rebuild work has started, in the
            workshop or 1:1. I can't take that work back.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .llu-tier__mode { margin-bottom: 0; color: var(--fg); line-height: 1.5; }
  .llu-tier__label {
    display: inline-block; margin-right: 6px; padding: 2px 10px; border-radius: 999px;
    font-size: 13px; font-weight: 700; color: var(--llu-white); background: var(--llu-blue);
  }
</style>

---
/** Avatar stack + stars + "200+ professionals coached". Faces are from clients' own LinkedIn reviews. */
import { proofFaces, faceSrc, proofStats } from "@data/proof";
interface Props { tone?: "dark" | "light"; align?: "start" | "center"; class?: string }
const { tone = "dark", align = "start", class: className = "" } = Astro.props;
---

<div class:list={["pb", `pb--${tone}`, `pb--${align}`, className]}>
  <div class="pb__faces" aria-hidden="true">
    {proofFaces.map((f) => <span class="pb__face"><img src={faceSrc(f.key)} alt="" width="48" height="48" loading="eager" decoding="async" /></span>)}
    <span class="pb__face pb__face--count">{proofStats.coached}</span>
  </div>
  <div class="pb__text">
    <span class="pb__stars" role="img" aria-label={`Rated ${proofStats.avgRating} out of 5 by ${proofStats.surveyed} surveyed members`}>
      {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L10 14.9l-5.25 2.7 1-5.8L1.5 7.7l5.9-.9z" /></svg>)}
    </span>
    <span class="pb__line"><strong>{proofStats.coached} professionals coached</strong> · {proofStats.raises} in raises</span>
  </div>
</div>

<style>
  .pb { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  .pb--center { justify-content: center; }
  .pb__faces { display: flex; align-items: center; padding-left: 3px; }
  .pb__face {
    position: relative; flex: none; width: 48px; height: 48px; margin-left: -10px;
    border-radius: 999px; overflow: hidden; background: #e5e7eb;
    box-shadow: 0 0 0 3px var(--pb-ring);
  }
  .pb__face:first-child { margin-left: 0; }
  /* The source crops are circles from LinkedIn: zoom in slightly so no white edge shows. */
  .pb__face img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); }
  .pb__face--count {
    display: grid; place-items: center; background: #0161ef; color: #fff;
    font-size: 13px; font-weight: 700; letter-spacing: -0.01em;
  }
  .pb__text { display: flex; flex-direction: column; gap: 2px; text-align: left; }
  .pb__stars { display: inline-flex; gap: 2px; color: #f6bf3b; }
  .pb__line { font-size: 15px; line-height: 1.35; color: var(--pb-text); }
  .pb__line strong { color: var(--pb-strong); font-weight: 600; }
  .pb--dark { --pb-ring: #030620; --pb-text: rgba(255, 255, 255, 0.72); --pb-strong: #fff; }
  .pb--light { --pb-ring: #fff; --pb-text: #4b5563; --pb-strong: #030620; }
  @media (max-width: 420px) { .pb__face { width: 38px; height: 38px; margin-left: -9px; } .pb__face--count { font-size: 11px; } }
</style>

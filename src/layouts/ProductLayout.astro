---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProductCheckout from "@components/products/ProductCheckout";
import ClaimForm from "@components/products/ClaimForm";
import { CONSENT_TEXT } from "@/lib/consent";

interface Props {
  title: string;
  description: string;
  headline: string;
  subheadline?: string;
  bullets?: string[];
  price: string;
  originalPrice?: string;
  ctaText?: string;
  ctaHref: string;
  guaranteeText?: string;
  faq?: { q: string; a: string }[];
  /** Shows Stripe's embedded checkout at #checkout for this product. */
  productSlug?: string;
  /** Product mockup shown in the hero. */
  image?: { src: string; alt: string; width: number; height: number };
  /** Folder in public/images/products with hero, inside, skills and og images (see scripts/mockups). */
  mockups?: string;
  /** Free product: an email signup instead of checkout. */
  free?: boolean;
}

const {
  title,
  description,
  headline,
  subheadline,
  bullets = [],
  price,
  originalPrice,
  ctaText = "Get Instant Access",
  ctaHref,
  guaranteeText = "30-day money-back guarantee. No questions asked.",
  faq = [],
  productSlug,
  mockups,
  free = false,
} = Astro.props;
const base = mockups ? `/images/products/${mockups}` : "";
const image = Astro.props.image || (mockups ? { src: `${base}/${mockups === "complete-toolkit" ? "bundle" : "hero"}.webp`, alt: `${title.split(" | ")[0]}: what you get`, width: 1600, height: 1000 } : undefined);
const publishableKey = import.meta.env.STRIPE_PUBLISHABLE_KEY || "";

const currentYear = new Date().getFullYear();
---

<BaseLayout title={title} description={description} type="website" image={mockups ? `${base}/og.jpg` : undefined}>
  <div class="min-h-screen bg-white">
    <!-- Minimal Header -->
    <header class="border-b border-border/50 bg-white">
      <div class="mx-auto max-w-[720px] px-4 py-4 text-center">
        <a href="/" class="text-lg font-bold text-blue">ClearCareer</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="bg-gradient-to-b from-blue-bg/50 to-white py-12 md:py-16">
      <div class="mx-auto max-w-[640px] px-4 text-center">
        <h1 class="font-display text-[clamp(1.75rem,4vw,2.75rem)] leading-[1.1] text-navy">
          <Fragment set:html={headline} />
        </h1>
        {subheadline && (
          <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-text-muted">
            {subheadline}
          </p>
        )}

        {bullets.length > 0 && (
          <ul class="mx-auto mt-6 max-w-md space-y-3 text-left">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-[1.0625rem] text-text">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        )}

        {image && (
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            class="mx-auto mt-8 h-auto w-full max-w-[600px]"
            fetchpriority="high"
            decoding="async"
          />
        )}

        <!-- Price + CTA -->
        <div class="mt-8">
          <div class="flex items-center justify-center gap-3">
            <span class="text-3xl font-bold text-navy">{price}</span>
            {originalPrice && (
              <span class="text-lg text-text-muted line-through">{originalPrice}</span>
            )}
          </div>
          <a
            href={ctaHref}
            class="mt-4 inline-flex items-center justify-center rounded-lg bg-blue px-8 py-4 text-lg font-semibold text-white shadow-md transition-colors hover:bg-blue-dark"
          >
            {ctaText}
          </a>
          <p class="mt-3 flex items-center justify-center gap-2 text-sm text-text-muted">
            <svg class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            {guaranteeText}
          </p>
        </div>

        <!-- Social Proof -->
        <p class="mt-6 text-sm font-medium text-text-muted">
          200+ professionals coached · $1.2M+ in collective raises
        </p>
      </div>
    </section>

    {productSlug && (
      <section id="checkout" class="scroll-mt-6 bg-blue-bg/30 py-12">
        <div class="mx-auto max-w-[720px] px-4">
          {free ? (
            <>
              <h2 class="mb-2 text-center text-xl font-bold text-navy">Get it free</h2>
              <p class="mb-6 text-center text-sm text-text-muted">Tell me where to send it. It opens right away, and the link is emailed to you.</p>
              <ClaimForm client:visible productSlug={productSlug} productName={title.split(" | ")[0]} consentText={CONSENT_TEXT} />
            </>
          ) : (
            <>
              <h2 class="mb-2 text-center text-xl font-bold text-navy">Get instant access</h2>
              <p class="mb-6 text-center text-sm text-text-muted">Secure checkout by Stripe. Your access link opens right after you pay, and it's emailed to you.</p>
              <ProductCheckout client:visible productSlug={productSlug} publishableKey={publishableKey} />
            </>
          )}
        </div>
      </section>
    )}

    {mockups && (
      <section class="py-10 md:py-14">
        <div class="mx-auto grid max-w-[1040px] gap-6 px-4 md:grid-cols-2">
          <figure>
            <img src={`${base}/inside.webp`} alt="The guides inside, shown as pages" width="1600" height="1000" loading="lazy" decoding="async" class="h-auto w-full rounded-2xl border border-border/60" />
            <figcaption class="mt-2 text-center text-sm text-text-muted">Every guide opens in your browser, with a Start Here page first.</figcaption>
          </figure>
          <figure>
            <img src={`${base}/skills.webp`} alt="The Claude skills you install" width="1600" height="1000" loading="lazy" decoding="async" class="h-auto w-full rounded-2xl border border-border/60" />
            <figcaption class="mt-2 text-center text-sm text-text-muted">Claude skills (text files only), plus copy-paste prompts for any AI.</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- Product Preview / Content -->
    <section class="py-8 md:py-12">
      <div class="mx-auto max-w-[720px] px-4">
        <slot name="preview" />
      </div>
    </section>

    <!-- Testimonial / Social Proof -->
    <slot name="testimonial" />

    <!-- FAQ -->
    {faq.length > 0 && (
      <section class="bg-blue-bg/30 py-12">
        <div class="mx-auto max-w-[640px] px-4">
          <h2 class="mb-8 text-center text-xl font-bold text-navy">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faq.map(({ q, a }) => (
              <details class="group rounded-xl border border-border bg-white px-6 py-4">
                <summary class="flex cursor-pointer items-center justify-between font-semibold text-navy">
                  {q}
                  <svg class="h-5 w-5 shrink-0 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-text-muted">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <section class="py-12 text-center">
      <div class="mx-auto max-w-[480px] px-4">
        <div class="flex items-center justify-center gap-3">
          <span class="text-3xl font-bold text-navy">{price}</span>
          {originalPrice && (
            <span class="text-lg text-text-muted line-through">{originalPrice}</span>
          )}
        </div>
        <a
          href={ctaHref}
          class="mt-4 inline-flex items-center justify-center rounded-lg bg-blue px-8 py-4 text-lg font-semibold text-white shadow-md transition-colors hover:bg-blue-dark"
        >
          {ctaText}
        </a>
        <p class="mt-3 flex items-center justify-center gap-2 text-sm text-text-muted">
          <svg class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          {guaranteeText}
        </p>
      </div>
    </section>

    <!-- Minimal Footer -->
    <footer class="border-t border-border/50 py-6 text-center">
      <p class="text-xs text-text-muted">&copy; {currentYear} ClearCareer. All rights reserved.</p>
    </footer>
  </div>
</BaseLayout>

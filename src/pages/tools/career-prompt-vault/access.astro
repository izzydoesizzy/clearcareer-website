---
/**
 * Career Prompt Vault access. Opens with a signed link (?t=, also from the Complete Toolkit bundle)
 * or a paid Checkout Session (?session_id=). Everything shown comes from src/products/vault,
 * which is private: nothing here is a public file.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ProductAccessHub from "@components/products/ProductAccessHub";
import { verifyAccess } from "../../../lib/product-access";
import { serverEnv } from "../../../lib/server-env";
import { skillsFor, startHere, promptCards, projectInstructions, bonusDocs } from "../../../lib/product-files";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "same-origin");

const token = Astro.url.searchParams.get("t") || Astro.url.searchParams.get("session_id") || "";
const access = await verifyAccess("vault", token, serverEnv(), Astro.url);
---

{access.ok ? (
<BaseLayout title="Career Prompt Vault: your access | ClearCareer" description="Your Career Prompt Vault: 6 Claude skills and 50 copy-paste prompts." noindex={true}>
  <ProductAccessHub
    client:load
    productName="Career Prompt Vault"
    productSlug="vault"
    buyerName={access.name || ""}
    buyerEmail={access.email || ""}
    guides={[]}
    accessToken={token}
    startHere={startHere("vault")}
    skills={skillsFor("vault")}
    prompts={promptCards("vault")}
    docs={bonusDocs("vault")}
    extraDownloads={projectInstructions("vault") ? [{ label: "Setup text for Claude Projects, GPTs and Gems", file: "project-instructions.md" }] : []}
  />
</BaseLayout>
) : (
<PageLayout title="Access not found | ClearCareer" description="Career Prompt Vault access page." noindex={true}>
  <div class="flex min-h-screen items-center justify-center bg-white">
    <div class="mx-auto max-w-md px-4 text-center">
      <h1 class="mb-4 font-display text-2xl font-bold text-navy">Access not found</h1>
      <p class="mb-6 text-text-muted">
        This access link isn't valid, or the payment hasn't been confirmed yet. If you just bought the
        Career Prompt Vault, open the link in your purchase email. It can take a few minutes to arrive.
      </p>
      <div class="space-y-3">
        <a href="/tools/career-prompt-vault" class="inline-block rounded-lg bg-blue px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-dark">See the Career Prompt Vault</a>
        <p class="text-xs text-text-muted">Need help? <a href="mailto:izzy@joinclearcareer.com" class="text-blue underline">izzy@joinclearcareer.com</a></p>
      </div>
    </div>
  </div>
</PageLayout>
)}

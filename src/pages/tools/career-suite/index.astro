---
import SalesLayout from "@layouts/SalesLayout.astro";
import CareerSuiteCheckout from "@components/career-suite/CareerSuiteCheckout";
import { CAREER_SUITE_PRICE, CAREER_SUITE_PRICE_COMPARE, SUITE_SKILLS, PLATFORMS } from "../../../data/career-suite";

const PRODUCT_NAME = "The ClearCareer Career Suite";
const STRIPE_PK = import.meta.env.STRIPE_PUBLISHABLE_KEY || "";

const steps = [
  { n: "1", title: "Get clear, fast", desc: "Upload your resume. In 15 minutes you have working job titles and honest feedback on what's holding your resume back." },
  { n: "2", title: "Get interviewed", desc: "Switch on voice mode and talk through every role. The AI asks one question at a time until your work has numbers on it." },
  { n: "3", title: "Lock your targets", desc: "With real evidence in hand, get your final 5 titles, pay for your city with sources, and 20 to 30 companies to go after." },
  { n: "4", title: "Get found", desc: "New resume bullets, 8 professional summaries and a rebuilt LinkedIn profile, all written from your own numbers." },
  { n: "5", title: "Let the search run itself", desc: "Job alerts plus a scheduled daily scout that finds, checks and scores new roles, then hands you the top 3 to apply to." },
];

const beforeAfter = [
  { before: "Managed vendor contracts for the region.", after: "Renegotiated the 5 largest of 40 regional vendor contracts, saving $180K a year." },
  { before: "Helped roll out the new CRM.", after: "Led a 9-month CRM rollout across 6 departments and 350 employees, finishing 3 weeks early." },
  { before: "Responsible for customer support.", after: "Lifted customer satisfaction from 72% to 97% by rebuilding the workflow for a 12-person support team." },
];

const faqItems = [
  { q: "Which AI do I need?", a: "Claude, ChatGPT or Gemini. You get a version of every tool formatted for each one: Claude Skills, ChatGPT Custom GPTs and Gemini Gems. Voice interviews, deep research and scheduled job searches work best on paid plans." },
  { q: "What if I don't know my numbers?", a: "That's the point. The interviewer never lets \"I don't know\" end a question. It helps you get to a conservative number you can explain, using things you do know like team size, how often something happened and how long it took." },
  { q: "Do I have to use voice mode?", a: "No. You can type every answer. Most people remember more and go deeper when they talk it through, so we recommend voice for the interview." },
  { q: "How long does it take?", a: "Your resume is done in about a week of short sessions: a 15-minute quick start, 2 to 3 voice sittings of 20 to 45 minutes, then a 30-minute full report. LinkedIn, alerts and your job search autopilot take another hour or so." },
  { q: "I'm in Land and Level Up. Do I pay for this?", a: "No. Use the member code from the community at checkout and it's free." },
  { q: "What if it doesn't work for me?", a: "Email within 48 hours for a full refund." },
];

const sidebarItems = [
  "6 AI tools, in the order you use them",
  "Versions for Claude, ChatGPT and Gemini",
  "Voice-mode achievement interview",
  "Location-specific salary research",
  "Scheduled daily job search with a 100-point fit score",
  "Step-by-step guide",
];
---

<SalesLayout title={`${PRODUCT_NAME} | ClearCareer`} description="Six AI tools for Claude, ChatGPT and Gemini that quantify your resume through a voice interview, find your best-fit roles and run your job search for you.">
  <div class="min-h-screen bg-white">
    <div class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-[1200px] items-center justify-between px-4 py-3 sm:px-6">
        <span class="text-lg font-bold text-navy">Clear<span class="text-blue">Career</span></span>
        <a href="#checkout" class="rounded-lg bg-blue px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-dark">Get It Now - {CAREER_SUITE_PRICE}</a>
      </div>
    </div>

    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[1fr_380px] lg:gap-10 xl:gap-14">
        <div>
          <section class="pb-10 pt-10 md:pt-16">
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue-bg px-4 py-1.5 text-sm font-medium text-navy">
              <span class="flex text-warning">★★★★★</span>
              <span>200+ professionals coached</span>
            </div>
            <h1 class="font-display text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.1] text-navy">Most people undersell their work. This fixes that, then finds the jobs.</h1>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-text-muted">{PRODUCT_NAME} turns Claude, ChatGPT or Gemini into a career coach that interviews you out loud, puts numbers on every role, and runs a daily search for the jobs you're most likely to land.</p>
            <p class="mt-6 text-sm text-text-muted">
              <span class="font-semibold text-navy">{CAREER_SUITE_PRICE}</span>
              <span class="ml-1 line-through">{CAREER_SUITE_PRICE_COMPARE}</span>
              <span class="mx-2 text-border">|</span> Lifetime access
              <span class="mx-2 text-border">|</span> 48-hour money-back guarantee
            </p>
          </section>

          <a href="#checkout" class="mb-10 inline-flex items-center justify-center rounded-lg bg-blue px-6 py-3 text-base font-bold text-white shadow-lg hover:bg-blue-dark lg:hidden">Get the Career Suite - {CAREER_SUITE_PRICE}</a>

          <section class="pb-12">
            <h2 class="font-display text-[clamp(1.25rem,3vw,1.75rem)] text-navy">"I don't know the number" is where good resumes go to die</h2>
            <div class="mt-6 space-y-4 text-base leading-relaxed text-text-muted">
              <p>You did real work. But your resume says "responsible for" and "helped with", because nobody tracked the numbers and you don't want to make something up.</p>
              <p>So recruiters skim past you, and you keep applying to the same 2 or 3 titles, wondering why it's quiet.</p>
              <p class="font-medium text-navy">The Career Suite interviews you the way I interview clients: one question at a time, never letting "I don't know" end the question, until every role has a number you can stand behind.</p>
            </div>
            <div class="mt-8 space-y-4">
              {beforeAfter.map((b) => (
                <div class="grid gap-3 rounded-xl border border-border p-4 sm:grid-cols-2">
                  <div class="rounded-lg bg-red-50 p-3"><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-red-400">Before</p><p class="text-sm italic text-text-muted">"{b.before}"</p></div>
                  <div class="rounded-lg bg-green-50 p-3"><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-green-600">After the interview</p><p class="text-sm italic text-navy">"{b.after}"</p></div>
                </div>
              ))}
            </div>
          </section>

          <section class="pb-12">
            <h2 class="font-display text-[clamp(1.25rem,3vw,1.75rem)] text-navy">How it works</h2>
            <div class="mt-6 space-y-5">
              {steps.map((s) => (
                <div class="flex gap-4">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">{s.n}</div>
                  <div><h3 class="font-bold text-navy">{s.title}</h3><p class="mt-1 text-sm leading-relaxed text-text-muted">{s.desc}</p></div>
                </div>
              ))}
            </div>
          </section>

          <section class="pb-12">
            <h2 class="font-display text-[clamp(1.25rem,3vw,1.75rem)] text-navy">The 6 tools</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {SUITE_SKILLS.map((s) => (
                <div class="rounded-xl border border-border bg-white p-5 shadow-[0_4px_24px_-4px_rgba(1,97,239,0.10)]">
                  <p class="text-xs font-semibold uppercase tracking-wider text-blue">{s.step}</p>
                  <h3 class="mt-1 font-bold text-navy">{s.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-text-muted">{s.summary}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="pb-12">
            <h2 class="font-display text-[clamp(1.25rem,3vw,1.75rem)] text-navy">Works in the AI you already use</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {PLATFORMS.map((p) => (
                <div class="rounded-xl border border-border p-5 text-center">
                  <h3 class="font-display text-lg text-navy">{p.name}</h3>
                  <p class="mt-1 text-sm text-text-muted">{p.format}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="pb-16">
            <h2 class="font-display text-[clamp(1.25rem,3vw,1.75rem)] text-navy">Questions</h2>
            <div class="mt-6 divide-y divide-border rounded-xl border border-border">
              {faqItems.map((f) => (
                <details class="group p-5">
                  <summary class="cursor-pointer list-none font-semibold text-navy">{f.q}</summary>
                  <p class="mt-2 text-sm leading-relaxed text-text-muted">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        </div>

        <!-- One checkout only: Stripe allows a single embedded checkout per page. Sidebar on desktop, after the content on mobile. -->
        <div class="pb-16 lg:pb-0">
          <div class="pt-2 lg:sticky lg:top-[72px] lg:pt-16" id="checkout">
            <div class="rounded-2xl border border-border bg-white p-6 shadow-xl">
              <h3 class="font-display text-xl text-navy">{PRODUCT_NAME}</h3>
              <div class="mt-3 flex items-baseline gap-2">
                <span class="text-3xl font-bold text-navy">{CAREER_SUITE_PRICE}</span>
                <span class="text-lg text-text-muted line-through">{CAREER_SUITE_PRICE_COMPARE}</span>
              </div>
              <p class="mt-1 text-xs text-text-muted">One-time payment. Lifetime access.</p>
              <div class="mt-5 space-y-2">
                {sidebarItems.map((item) => <div class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg><span class="text-sm text-navy">{item}</span></div>)}
              </div>
              <div class="mt-5 border-t border-border pt-5">
                <p class="mb-3 text-center text-sm font-semibold text-navy">Secure Checkout</p>
                <CareerSuiteCheckout client:visible publishableKey={STRIPE_PK} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="fixed bottom-0 left-0 right-0 z-40 border-t border-border bg-white/95 p-3 backdrop-blur-sm lg:hidden">
      <a href="#checkout" class="flex w-full items-center justify-center gap-2 rounded-lg bg-blue py-3 text-base font-bold text-white shadow-lg">Get the Career Suite - {CAREER_SUITE_PRICE}</a>
    </div>

    <footer class="border-t border-border bg-white py-8 pb-20 lg:pb-8">
      <div class="mx-auto max-w-[1200px] px-4 text-center text-sm text-text-muted sm:px-6">
        <p>&copy; {new Date().getFullYear()} ClearCareer. All rights reserved.</p>
      </div>
    </footer>
  </div>
</SalesLayout>

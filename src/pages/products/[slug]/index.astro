---
/**
 * Old product pages (/products/script-vault, with or without the slash) redirect to their new
 * home. Real product pages are their own folders and win over this. Anything else gets the 404.
 */
import NotFound from "../../404.astro";
import { PRODUCT_REDIRECTS } from "../../../data/product-redirects.mjs";

export const prerender = false;

const to = (PRODUCT_REDIRECTS as Record<string, string>)[Astro.params.slug ?? ""];
if (to) return Astro.redirect(to, 301);
Astro.response.status = 404;
---

<NotFound />

---
/**
 * Old product pages with a trailing slash (/products/script-vault/). The exact URLs redirect in
 * astro.config.mjs; this catches the slash version and sends it to the same place. Anything else
 * that isn't a real product page gets the normal 404.
 */
import NotFound from "../../404.astro";
import { PRODUCT_REDIRECTS } from "../../../data/product-redirects.mjs";

export const prerender = false;

const to = (PRODUCT_REDIRECTS as Record<string, string>)[Astro.params.slug ?? ""];
if (to) return Astro.redirect(to, 301);
Astro.response.status = 404;
---

<NotFound />

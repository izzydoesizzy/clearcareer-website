---
/**
 * Land and Level Up: founding-group sales page.
 * Visual system: /design.md. Every number and quote: src/data/llu.ts.
 * No client JavaScript. No data-animate. One primary action.
 *
 * LAUNCH CHECKLIST: remove `noindex` here, remove the sitemap filter in astro.config.mjs,
 * and paste the live Stripe and application links into src/data/llu.ts.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import "@/styles/llu.css";

import LluNav from "@components/llu/LluNav.astro";
import LluHero from "@components/llu/LluHero.astro";
import LluIsThisYou from "@components/llu/LluIsThisYou.astro";
import LluReviews from "@components/llu/LluReviews.astro";
import LluNumbers from "@components/llu/LluNumbers.astro";
import LluFounder from "@components/llu/LluFounder.astro";
import LluProduct from "@components/llu/LluProduct.astro";
import LluFirstWeek from "@components/llu/LluFirstWeek.astro";
import LluAnchor from "@components/llu/LluAnchor.astro";
import LluPricing from "@components/llu/LluPricing.astro";
import LluGuarantee from "@components/llu/LluGuarantee.astro";
import LluObjections from "@components/llu/LluObjections.astro";
import LluClose from "@components/llu/LluClose.astro";
import LluFooter from "@components/llu/LluFooter.astro";

const title = "Land and Level Up | A job search community by ClearCareer";
const description =
  "A small, paid room for experienced professionals between roles. Your resume and LinkedIn rebuilt 1:1 with Izzy, plus a live group call every Wednesday. 20 founding seats. Starts December 7, 2026.";
---

<BaseLayout title={title} description={description} image="/open-graph/land-and-level-up.png" noindex>
  <div class="llu">
    <LluNav />
    <main id="main-content">
      <LluHero />
      <LluIsThisYou />
      <LluReviews />
      <LluNumbers />
      <LluFounder />
      <LluProduct />
      <LluFirstWeek />
      <LluAnchor />
      <LluPricing />
      <LluGuarantee />
      <LluObjections />
      <LluClose />
    </main>
    <LluFooter />
  </div>
</BaseLayout>

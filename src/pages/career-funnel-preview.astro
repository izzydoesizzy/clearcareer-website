---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@/styles/llu.css";
import { offer } from "@data/llu";
import { sandbox, allowedOrigin, state, COOKIE, offers, format } from "../lib/career-funnel-test";
export const prerender = false;
Astro.response.headers.set("Cache-Control","private, no-store");
Astro.response.headers.set("Referrer-Policy","no-referrer");
const stripe = allowedOrigin(Astro.url) ? sandbox() : null;
const cookie = Astro.cookies.get(COOKIE)?.value;
let x: Awaited<ReturnType<typeof state>> = null;
let verificationFailed = false;
if (stripe && cookie) {
  try { x = await state(stripe,cookie); } catch { verificationFailed = true; }
}
const status = Astro.url.searchParams.get("checkout");
const key = x?.key ?? (Astro.url.searchParams.get("variant")==="b" ? "b" : "a");
const item = offers[key];
const stage = !x ? (Astro.url.searchParams.get("step")==="checkout"?"checkout":"offer") : !x.firstDone ? "first" : !x.secondDone ? "group" : "complete";
const groupPrice = x?.group ?? (offer.dealLive ? 94900 : 120000);
const restart = "/api/career-funnel/upgrade";
const total = x ? x.base+(x.firstPaid?x.offer.nextAmount:0)+(x.secondPaid?x.due:0) : item.amount;
const fit = x?.s.metadata?.fit==="yes";
const error = ["unavailable","payment-failed","consent","invalid","pending"].includes(status ?? "") || verificationFailed || (status==="success"&&!x);
const unableToStart = !stripe || verificationFailed || (status==="success"&&!x);
---
<BaseLayout title="Career Toolkit | ClearCareer sandbox" description="Stripe test-mode preview of the ClearCareer product and coaching funnel." noindex>
  <div class="llu funnel">
    <header class="llu-nav"><div class="llu-wrap llu-nav__row">
      <span class="llu-nav__brand"><span class="llu-nav__mark">ClearCareer</span></span>
      <span class="llu-cap">Stripe sandbox · No real money</span>
    </div></header>
    <main id="main-content">
      <section class="llu-band llu-band--white compact"><div class="llu-wrap llu-stack">
        <p class="llu-cap">Private review concept · Test payments only · CAD · Before tax</p>
        <p class="llu-strong">{stage==="offer"?"1. Offer":stage==="checkout"?"2. Checkout":stage==="first"?"3. Optional upgrade":stage==="group"?"4. Coaching upgrade":"5. Confirmation"}</p>
        {!x && <div class="switcher"><a class:list={["llu-pill",key==="a"&&"selected"]} href="/career-funnel-preview?variant=a">$9 Prompt Vault</a><a class:list={["llu-pill",key==="b"&&"selected"]} href="/career-funnel-preview?variant=b">$49 Toolkit bundle</a></div>}
        {!stripe && <p role="alert">Sandbox checkout is unavailable on this deployment. Check the dedicated test secret key and preview branch. No live Stripe key is used.</p>}
        {error && <p role="alert">{status==="payment-failed"?"Stripe did not confirm the upgrade. You can skip it or start a new test. If authentication is required, this version does not handle the additional verification screen.":status==="pending"?"Payment is still pending. Refresh before proceeding.":"Checkout or payment verification is unavailable. No success is assumed. Check the sandbox or restart the test."}</p>}
        {status==="cancelled" && <p role="status">Checkout cancelled. No successful payment has been verified.</p>}
      </div></section>
      {stage==="offer" && <section>
        <div class="llu-band llu-band--navy"><div class="llu-wrap llu-row">
          <div class="llu-stack"><p class="llu-eyebrow">{key==="a"?"50 AI career frameworks":"Proposed bundle of existing resources"}</p>
            <h1 class="llu-display">{key==="a"?"Stop asking AI for generic career advice.":"Build a job search system you can actually use."}</h1>
            <p class="llu-lead">{key==="a"?"Turn ChatGPT, Claude or your favourite AI assistant into a practical career strategist with 50 structured frameworks.":"Start with AI prompts, interview preparation and ready-to-send scripts in one self-serve toolkit."}</p>
            <a class="llu-btn" href={"/career-funnel-preview?variant="+key+"&step=checkout"}>Get instant access · {format(item.amount)}</a>
          </div>
          <div class="llu-card llu-stack"><p class="llu-eyebrow">Your toolkit</p><h2 class="llu-h3">{item.name}</h2>
            <ul class="llu-list">{(key==="a"?["50 frameworks across six categories","Custom AI system prompt and setup guide","Quick-start guide and bonus resources"]:["Career Prompt Vault","Interview Confidence System","Job Search Script Vault"]).map(i=><li>{i}</li>)}</ul>
            <p class="llu-tier__price">{format(item.amount)}</p>
            <p class="llu-cap">One-time sandbox payment. No subscription.</p>
            <a class="llu-btn llu-btn--wide" href={"/career-funnel-preview?variant="+key+"&step=checkout"}>Get instant access · {format(item.amount)}</a>
          </div>
        </div></div>
        <div class="llu-band llu-band--white"><div class="llu-wrap llu-row">
          <div class="llu-stack"><p class="llu-eyebrow">The receipts</p><h2 class="llu-h2">Real people. Real results.</h2><p>See what past ClearCareer clients have achieved through coaching. Individual outcomes vary; these are not promises about the digital products.</p><a class="llu-link" href="/outcomes">See the outcomes report</a></div>
          <img class="receipt" src="/images/llu/receipts/victor.webp" alt="Past ClearCareer client message" width="640" height="1017" loading="lazy"/>
        </div></div>
      </section>}
      {stage==="checkout" && <section class="llu-band"><div class="llu-wrap narrow"><form class="llu-card llu-stack" action="/api/career-funnel/checkout" method="post" id="checkout-form">
        <p class="llu-eyebrow">Secure test checkout</p><h1 class="llu-h2">Get your toolkit.</h1>
        <input type="hidden" name="variant" value={key}/>
        <div class="line"><span>{item.name}</span><strong>{format(item.amount)}</strong></div>
        <label class="bump"><input type="checkbox" name="bump" value="yes" id="bump"/><span><strong>Add the Salary Number Generator for $9 CAD</strong><br/><span class="llu-cap">Calculate target, anchor and walk-away numbers, with scripts.</span></span></label>
        <div class="line"><strong>Test subtotal</strong><strong id="checkout-total" data-base={item.amount}>{format(item.amount)}</strong></div>
        <label class="llu-consent"><input type="checkbox" name="consent" value="yes" required/><span>I agree to save my test payment method for separately accepted optional upgrades during this sandbox session. No real money will be charged.</span></label>
        <p class="llu-cap">Use 4242 4242 4242 4242, expiry 12/30, CVC 123, and fictional customer details. Do not use a real card.</p>
        <button class="llu-btn llu-btn--wide" type="submit" disabled={unableToStart}>Continue to Stripe test checkout</button>
        <a class="llu-link" href={"/career-funnel-preview?variant="+key}>Back to offer</a>
      </form></div></section>}
      {stage==="first" && x && <section class="llu-band"><div class="llu-wrap narrow"><div class="llu-card llu-stack">
        <p class="llu-cap">✓ Stripe confirmed your {format(x.base)} test purchase.</p><p class="llu-eyebrow">Optional upgrade · 1 of 2</p>
        <h1 class="llu-h2">{key==="a"?"Now you have the prompts. Get the words, too.":"Thinking about changing direction, too?"}</h1>
        <h2 class="llu-title">{item.next}</h2><p>{key==="a"?"100+ ready-to-use scripts for hiring managers, referrals, follow-ups, interviews and salary negotiation.":"Seven self-serve modules to plan your next career move."}</p>
        <p class="llu-tier__price">{format(item.nextAmount)}</p><p class="llu-cap">A separate Stripe test payment using the saved test card, only if you accept. Your initial purchase is yours either way.</p>
        <form method="post" action={restart} class="llu-stack"><button class="llu-btn llu-btn--wide" name="choice" value="first" disabled={!!x.first}>Yes, add to my order · {format(item.nextAmount)}</button><button class="skip" name="choice" value="skip-first">No thanks, continue</button></form>
      </div></div></section>}
      {stage==="group" && x && <section class="llu-band llu-band--navy"><div class="llu-wrap narrow llu-stack">
        <p class="llu-eyebrow">Optional upgrade · 2 of 2</p><h1 class="llu-h2">You have the tools. Want to do it together?</h1>
        <p class="llu-lead">Land and Level Up is a six-week group coaching program where we rebuild your resume and LinkedIn together and work your real search live.</p>
        <div class="llu-card llu-stack">
          <ul class="llu-list">{offer.group.includes.map(i=><li>{i}</li>)}</ul>
          <img class="receipt" src="/images/llu/community-wins-560.webp" alt="Past ClearCareer community sharing job search wins" width="560" height="560" loading="lazy"/>
          <div class="line"><span>Group program price</span><strong>{format(groupPrice)}</strong></div>
          <div class="line"><span>Proposed credit for digital purchases</span><strong>−{format(x.base+(x.firstPaid?item.nextAmount:0))}</strong></div>
          <p class="llu-tier__price">{format(x.due)}</p><p class="llu-cap">Additional sandbox payment, before tax. No real enrollment or subscription. Credit is a proposed test.</p>
          <form action={restart} method="post" class="llu-stack"><button class="llu-btn llu-btn--wide" name="choice" value="group" disabled={!!x.second}>Yes, upgrade · {format(x.due)}</button><button class="skip" name="choice" value="fit">Not sure yet? Explore a free fit call</button><button class="skip" name="choice" value="skip-group">No thanks, take me to my purchases</button></form>
        </div>
      </div></section>}
      {stage==="complete" && x && <section class="llu-band"><div class="llu-wrap narrow"><div class="llu-card llu-stack">
        <p class="llu-eyebrow">Sandbox complete</p><h1 class="llu-h2">Your next step starts here.</h1>
        <p>These purchases were verified against Stripe test-mode records. No real money was charged or real enrollment created.</p>
        <div class="line"><span>{item.name}</span><strong>{format(item.amount)}</strong></div>
        {x.bump&&<div class="line"><span>Salary Number Generator</span><strong>{format(900)}</strong></div>}
        {x.firstPaid&&<div class="line"><span>{item.next}</span><strong>{format(item.nextAmount)}</strong></div>}
        {x.secondPaid&&<div class="line"><span>Land and Level Up (after credit)</span><strong>{format(x.due)}</strong></div>}
        <div class="line"><strong>Total Stripe test payments</strong><strong>{format(total)}</strong></div>
        <div class="line"><strong>Actual money charged</strong><strong>$0.00 CAD</strong></div>
        {!x.secondPaid ? <div class="bump llu-stack fit"><p class="llu-eyebrow">{fit?"You chose a fit call":"Optional next step"}</p><h2 class="llu-h3">Want a second set of eyes on your job search?</h2><p>Tell me about your situation and see if we're a good fit.</p><a class="llu-btn llu-btn--wide" href="https://joinclearcareer.com/book-a-call" target="_blank" rel="noopener noreferrer">View existing qualification form</a><p class="llu-cap">This opens the real form. Do not submit test details there; it is not connected to the sandbox.</p></div>:<div class="fit llu-stack"><h2 class="llu-h3">Welcome to Land and Level Up.</h2><p>Real customers would receive onboarding instructions here. This test does not send emails or enroll anyone.</p></div>}
        <form method="post" action={restart}><button class="skip" name="choice" value="restart">Start another test</button></form>
      </div></div></section>}
      {cookie && stage!=="complete" && <section class="llu-band compact"><div class="llu-wrap narrow"><form method="post" action={restart}><button class="llu-link" name="choice" value="restart">Reset this sandbox session</button></form></div></section>}
    </main>
    <footer class="llu-band llu-band--navy compact"><div class="llu-wrap"><p class="llu-cap">ClearCareer · Sandbox only. Tax, delivery, email, live inventory and onboarding integrations are not connected. The existing site analytics may run.</p></div></footer>
  </div>
</BaseLayout>
<style>
  .compact { padding:24px 0; }
  .narrow { max-width:760px; }
  .switcher { display:flex; flex-wrap:wrap; gap:8px; }
  .selected { background:var(--llu-blue); color:white; border-color:var(--llu-blue); }
  .line { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:12px 0; border-bottom:1px solid var(--llu-hairline); }
  .line strong { white-space:nowrap; }
  .bump,.fit { border:1px solid var(--llu-hairline); background:var(--llu-paper); padding:24px; border-radius:20px; }
  label.bump { display:flex; align-items:flex-start; gap:12px; cursor:pointer; }
  .bump input { width:20px;height:20px;flex:none;accent-color:var(--llu-blue);margin-top:4px; }
  .skip { display:block;width:100%;min-height:44px;color:var(--llu-blue);text-decoration:underline;text-underline-offset:4px;cursor:pointer; }
  .receipt { width:min(100%,320px);height:auto;justify-self:center;border-radius:20px; }
  .funnel :global(.llu-btn) { white-space:normal; }
  @media(max-width:767px) { .funnel :global(.llu-display) { font-size:clamp(38px,11vw,52px); } }
</style>
<script>
  const bump = document.querySelector<HTMLInputElement>("#bump");
  const total = document.querySelector<HTMLElement>("#checkout-total");
  if (bump && total) bump.addEventListener("change",()=>{total.textContent=new Intl.NumberFormat("en-CA",{style:"currency",currency:"CAD"}).format((Number(total.dataset.base)+(bump.checked?900:0))/100);});
  const form=document.querySelector<HTMLFormElement>("#checkout-form");
  form?.addEventListener("submit",()=>{const button=form.querySelector("button");if(button)button.disabled=true;});
</script>

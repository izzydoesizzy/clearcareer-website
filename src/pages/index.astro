---
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/Hero.astro";
import StatsBar from "@components/StatsBar.astro";
import TrustBar from "@components/TrustBar.astro";
import ProofBar from "@components/proof/ProofBar.astro";
import WinsGrid from "@components/proof/WinsGrid.astro";
import ReviewWall from "@components/proof/ReviewWall.astro";
import ProofToast from "@components/proof/ProofToast.astro";
import { winNames } from "@data/proof";
import PricingCard from "@components/PricingCard.astro";
import { offer } from "@data/llu";
import CTASection from "@components/CTASection.astro";
import AiToolsGrid from "@components/AiToolsGrid.astro";
import { getCollection } from "astro:content";

import IndustryStatCard from "@components/IndustryStatCard.astro";
import SourceCitations from "@components/SourceCitations.astro";

// Get latest blog posts for homepage
const now = new Date();
const latestPosts = (await getCollection("blog", ({ data }) => {
  if (data.draft) return false;
  return new Date(data.publishDate) <= now;
}))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);
---

<PageLayout
  title="ClearCareer | Career Coaching That Gets Results"
  description="200+ professionals coached. $1.2M+ in collective raises. Land and Level Up: a 6-week group program where we rebuild your resume and LinkedIn together and work your search live. Book a free call."
>
  {/* ── 1. Hero ── */}
  <Hero
    variant="split"
    photoSrc="/images/izzy-profile.webp"
    photoAlt="Izzy Piyale-Sheard, career coach"
    eyebrow="Career Coaching That Actually Works"
    headline="Stop Grinding Alone. Start Getting <span class='bg-gradient-to-r from-blue to-blue-light bg-clip-text text-transparent'>Results.</span>"
    subheadline="Land and Level Up is my 6-week group program: we rebuild your resume and LinkedIn together, then work your real search live every Wednesday."
    primaryCTA={{ text: "Book a Free Call", href: "/book-a-call" }}
    secondaryCTA={{ text: "See Land and Level Up", href: "/land-and-level-up" }}
    trustText="Free 20-minute call · No commitment · No pressure"
  >
    <ProofBar slot="proof" tone="dark" />
  </Hero>

  {/* ── 2. Stats Bar ── */}
  <StatsBar />

  {/* ── 3. Trust Bar ── */}
  <TrustBar />

  {/* ── 4. Problem Section ── */}
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-animate="fade-up">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">The Problem</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
          You've Done Everything Right. So Why Isn't It Working?
        </h2>
      </div>

      <div class="mx-auto mt-6 max-w-[720px] text-center">
        <p class="text-lg leading-relaxed text-text-muted">
          You've tailored every resume. Optimized your LinkedIn. Applied to hundreds of roles. And still: silence. You're not alone. The average job search now takes over 5 months, and only ~8.5% of applications get callbacks. The system is broken. You need a different approach, built by someone who's helped 200+ professionals break through the same wall you're hitting right now.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3" data-animate-stagger>
        {/* Pain Point 1 */}
        <div class="rounded-xl bg-blue-bg p-6 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue/10">
            <svg class="h-6 w-6 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy">5.5 Months on Average</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            The average job search takes 5.5 months (BLS, 2025). For senior roles, it stretches to 6-9 months (LinkedIn, 2024). Every month at $100K+ costs ~$8,300 in lost income.
          </p>
        </div>

        {/* Pain Point 2 */}
        <div class="rounded-xl bg-blue-bg p-6 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue/10">
            <svg class="h-6 w-6 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="15" y1="9" x2="9" y2="15" />
              <line x1="9" y1="9" x2="15" y2="15" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy">100-200+ Applications</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            The typical job seeker sends 100-200+ applications before landing. Only ~8.5% get callbacks (Indeed, 2024). Up to 40% of listings may be ghost jobs that were never real (Resume Builder, 2024).
          </p>
        </div>

        {/* Pain Point 3 */}
        <div class="rounded-xl bg-blue-bg p-6 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue/10">
            <svg class="h-6 w-6 text-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy">85% Through Networking</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            Up to 85% of jobs are filled through networking (LinkedIn, 2024). Referral candidates are hired at 10x the rate of applicants (Jobvite, 2024). Yet most job seekers spend their time applying, not connecting.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4b. Industry Data Section ── */}
  <section class="bg-gradient-to-br from-slate-50 to-blue-bg/50 py-16 md:py-24">
    <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-animate="fade-up">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">The Data</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
          The Numbers Behind the Struggle
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-text-muted">
          These aren't our numbers. This is what the research says about job searching in 2025.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-animate-stagger>
        <IndustryStatCard
          number="5.5 months"
          label="Average job search"
          detail="1 in 5 are unemployed for 27+ weeks"
          source="BLS, 2025"
          color="warning"
        />
        <IndustryStatCard
          number="~8.5%"
          label="Application callback rate"
          detail="Most resumes never reach a human"
          source="Indeed, 2024"
          color="warning"
        />
        <IndustryStatCard
          number="85%"
          label="Jobs filled through networking"
          detail="Referrals are hired at 10x the rate"
          source="LinkedIn + Jobvite, 2024"
          color="blue"
        />
        <IndustryStatCard
          number="$750K+"
          label="Cost of not negotiating"
          detail="55% of workers never negotiate salary"
          source="HBR + Pew Research"
          color="warning"
        />
      </div>

      <SourceCitations
        variant="section"
        sources={[
          { source: "U.S. Bureau of Labor Statistics", year: 2025, url: "https://www.bls.gov/news.release/empsit.nr0.htm" },
          { source: "Indeed Hiring Lab", year: 2024, url: "https://www.hiringlab.org/" },
          { source: "LinkedIn Economic Graph", year: 2024, url: "https://economicgraph.linkedin.com/" },
          { source: "Jobvite Recruiter Nation Report", year: 2024, url: "https://www.jobvite.com/lp/recruiter-nation/" },
          { source: "Pew Research Center", year: 2023, url: "https://www.pewresearch.org/social-trends/2023/03/30/" },
          { source: "Harvard Business Review", year: 2023, url: "https://hbr.org/2014/06/why-women-dont-negotiate-their-job-offers" },
        ]}
      />
    </div>
  </section>

  {/* ── 5. How It Works ── */}
  <section class="bg-gradient-to-br from-slate-50 to-blue-bg/50 py-16 md:py-24">
    <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-animate="fade-up">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">How It Works</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
          From Stuck to Hired in 4 Steps
        </h2>
      </div>

      {/* Steps on the left, a real community win on the right (the 2024 site's layout). */}
      <div class="mt-12 grid items-center gap-12 md:grid-cols-[1fr_auto] md:gap-16 lg:gap-24">
        <ol class="mx-auto w-full max-w-xl" data-animate-stagger>
            <li class="relative flex gap-5 pb-10 last:pb-0">
              {/* Connector line to the next step */}
              <span class="absolute left-5 top-10 -ml-px h-[calc(100%-2.5rem)] border-l-2 border-dashed border-blue/20" aria-hidden="true"></span>
              <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">1</span>
              <div class="pt-1.5">
                <h3 class="text-base font-bold text-navy">Book a Free Call</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">20-minute call with Izzy to see where your search is stuck and whether we're the right fit.</p>
              </div>
            </li>
            <li class="relative flex gap-5 pb-10 last:pb-0">
              {/* Connector line to the next step */}
              <span class="absolute left-5 top-10 -ml-px h-[calc(100%-2.5rem)] border-l-2 border-dashed border-blue/20" aria-hidden="true"></span>
              <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">2</span>
              <div class="pt-1.5">
                <h3 class="text-base font-bold text-navy">Join Your Cohort</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">Pick the group cohort, or add a private 1:1 rebuild with Izzy. Small group, 16 seats.</p>
              </div>
            </li>
            <li class="relative flex gap-5 pb-10 last:pb-0">
              {/* Connector line to the next step */}
              <span class="absolute left-5 top-10 -ml-px h-[calc(100%-2.5rem)] border-l-2 border-dashed border-blue/20" aria-hidden="true"></span>
              <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">3</span>
              <div class="pt-1.5">
                <h3 class="text-base font-bold text-navy">Rebuild and Work Your Search</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">6 weeks of live Wednesday calls, a resume and LinkedIn rebuild workshop, and the AI Achievement Interviewer.</p>
              </div>
            </li>
            <li class="relative flex gap-5 pb-10 last:pb-0">
              {/* Connector line to the next step */}
              
              <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">4</span>
              <div class="pt-1.5">
                <h3 class="text-base font-bold text-navy">Land Your Next Role</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">Leave with a resume and LinkedIn that show your value, and a search that works. Stay on after for $49 a month.</p>
              </div>
            </li>
        </ol>

        <figure class="mx-auto w-full max-w-[260px] md:max-w-[300px]" data-animate="fade-up">
          <img
            src="/images/home/community-win.webp"
            width="430"
            height="876"
            loading="lazy"
            decoding="async"
            alt="A post in the ClearCareer community on a phone: I received an offer and accepted! I will be a Customer Success Relationship Manager. Y'all! I love this community Izzy has helped us build here. It feels like family! Members reply with congratulations."
            class="h-auto w-full drop-shadow-[0_24px_40px_rgba(3,6,32,0.25)]"
          />
          <figcaption class="mt-4 text-center text-sm text-text-muted">A real win, posted in the community.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ── 7. Featured Testimonials ── */}
  <!-- AI Prompts, Tools, & Templates (the 2024 site's "utility belt" grid) -->
  <AiToolsGrid />

  <section class="bg-blue-bg/30 py-16 md:py-24">
    <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-animate="fade-up">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">Client Results</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
          Real People, Real Results
        </h2>
      </div>

      <div class="mt-12">
        <WinsGrid tone="light" />
      </div>

      <div class="mt-16 text-center">
        <h3 class="font-display text-[clamp(1.25rem,2.5vw,1.75rem)] text-navy">In their own words</h3>
      </div>
      <div class="mt-8">
        <ReviewWall tone="light" exclude={winNames} />
      </div>
      <p class="mt-6 text-center text-sm text-gray-500">Real reviews from clients, colleagues and workshop attendees. Results vary.</p>

      <div class="mt-10 text-center">
        <a
          href="/testimonials"
          class="inline-flex items-center gap-2 text-base font-semibold text-blue transition-colors hover:text-blue-dark"
        >
          Read all 80+ testimonials
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* ── 8. Latest from the Blog ── */}
  {latestPosts.length > 0 && (
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
        <div class="text-center" data-animate="fade-up">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">From the Blog</p>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
            Career Strategies That Work
          </h2>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group overflow-hidden rounded-xl border border-border bg-white shadow-sm transition-shadow hover:shadow-md"
            >
              <div class="aspect-video bg-blue-bg" />
              <div class="p-6">
                {post.data.tags.length > 0 && (
                  <div class="mb-3 flex flex-wrap gap-2">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="rounded-full bg-blue-bg px-3 py-1 text-xs font-medium text-blue">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <h3 class="text-lg font-semibold text-navy group-hover:text-blue transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-sm text-text-muted line-clamp-2">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-base font-semibold text-blue transition-colors hover:text-blue-dark"
          >
            Read all articles
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* ── 9. Land and Level Up ── */}
  <section class="bg-gradient-to-br from-slate-50 to-blue-bg/50 py-16 md:py-24">
    <div class="mx-auto max-w-[1080px] px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-animate="fade-up">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-blue">Land and Level Up</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-navy">
          6 Weeks. Two Ways to Join.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-text-muted">
          We start {offer.startDateLong}. {offer.seatsTotal} founding seats. CAD plus HST.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-[760px] grid-cols-1 gap-8 md:grid-cols-2">
        <PricingCard
          tier={`${offer.group.name}: ${offer.group.mode}`}
          price={offer.group.price}
          originalPrice={offer.dealLive ? offer.group.regular : undefined}
          features={offer.group.includes}
          ctaText="See the details"
          ctaHref="/land-and-level-up#pricing"
          featured={true}
          paymentPlan={offer.dealLive ? "20% off with code BLACKFRIDAY. Or monthly with Klarna (Canada only)" : "Or monthly with Klarna (Canada only)"}
        />
        <PricingCard
          tier={`${offer.private.name}: ${offer.private.mode}`}
          price={offer.private.price}
          originalPrice={offer.dealLive ? offer.private.regular : undefined}
          features={offer.private.includes}
          ctaText="See the details"
          ctaHref="/land-and-level-up#pricing"
          paymentPlan={offer.dealLive ? "20% off with code BLACKFRIDAY. Or monthly with Klarna (Canada only)" : "Or monthly with Klarna (Canada only)"}
        />
      </div>
    </div>
  </section>

  {/* ── 9. Final CTA ── */}
  <CTASection
    heading="Ready to Stop Grinding <span class='bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent'>Alone?</span>"
    body="Book a free 20-minute call. We'll look at where your search is stuck and whether working together is the right fit."
    primaryCTA={{ text: "Book a Free Call", href: "/book-a-call" }}
    secondaryCTA={{ text: "See Land and Level Up", href: "/land-and-level-up" }}
    variant="gradient"
  />

  <ProofToast />
</PageLayout>
